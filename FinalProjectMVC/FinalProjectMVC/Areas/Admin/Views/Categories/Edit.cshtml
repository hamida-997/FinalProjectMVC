@model UpdateCategoryVM
@{
    ViewData["Title"] = "Edit Category";
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-edit"></i> Edit Category
                </h1>
                <p class="admin-page-subtitle">Update category information</p>
            </div>
            <div class="admin-breadcrumb">
                <i class="fas fa-home"></i>
                <span>Admin</span>
                <i class="fas fa-chevron-right separator"></i>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a>
                <i class="fas fa-chevron-right separator"></i>
                <span class="current">Edit</span>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-lg-8">
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="fas fa-info-circle"></i> Category Information</h3>
                    </div>
                    <div class="admin-panel-body">
                        <form asp-action="Edit" method="post">
                            @Html.AntiForgeryToken()
                            <input asp-for="Id" type="hidden" />

                            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                            {
                                <div class="alert-danger mb-3">
                                    <i class="fas fa-exclamation-circle me-2"></i>
                                    <div asp-validation-summary="ModelOnly"></div>
                                </div>
                            }

                            <div class="form-group-admin">
                                <label asp-for="Name" class="form-label-admin"></label>
                                <input asp-for="Name" class="form-control-admin" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group-admin">
                                <label asp-for="Description" class="form-label-admin"></label>
                                <textarea asp-for="Description" class="form-control-admin" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="form-group-admin">
                                <div class="form-check-admin">
                                    <input asp-for="IsActive" class="form-check-input-admin" />
                                    <label asp-for="IsActive" class="form-check-label-admin">
                                        Mark as active
                                        <small>(Active categories are visible to customers)</small>
                                    </label>
                                </div>
                            </div>

                            <div class="form-actions">
                                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn-admin-secondary">
                                    <i class="fas fa-times"></i> Cancel
                                </a>
                                <button type="submit" class="btn-admin-primary">
                                    <i class="fas fa-save"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="fas fa-exclamation-triangle"></i> Danger Zone</h3>
                    </div>
                    <div class="admin-panel-body">
                        <p class="text-muted mb-3">Deleting a category is permanent and cannot be undone. Make sure no products are associated with it.</p>
                        <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" method="post"
                              onsubmit="return confirm('Are you sure you want to delete this category? This action cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn-admin-danger w-100">
                                <i class="fas fa-trash-alt"></i> Delete Category
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
