@model List<CategoryVM>
@{
    ViewData["Title"] = "Categories";
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-th-large"></i> Categories
                </h1>
                <p class="admin-page-subtitle">Manage your product categories</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <div class="admin-breadcrumb">
                    <i class="fas fa-home"></i>
                    <span>Admin</span>
                    <i class="fas fa-chevron-right separator"></i>
                    <span class="current">Categories</span>
                </div>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn-admin-primary">
                    <i class="fas fa-plus"></i> Add Category
                </a>
            </div>
        </div>

        <!-- Table -->
        <div class="admin-table-wrapper mt-4">
            <div class="admin-table-header">
                <h3>
                    All Categories
                    <span class="badge-count">@Model.Count</span>
                </h3>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td><strong>#@category.Id</strong></td>
                                    <td>
                                        <div class="category-cell">
                                            <div class="category-icon">
                                                <i class="fas fa-folder"></i>
                                            </div>
                                            <strong>@category.Name</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-truncate-cell">
                                            @(string.IsNullOrEmpty(category.Description) ? "—" : category.Description)
                                        </span>
                                    </td>
                                    <td>
                                        @if (category.IsActive)
                                        {
                                            <span class="status-badge status-active">
                                                <i class="fas fa-check-circle"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <i class="fas fa-pause-circle"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>@category.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <div class="admin-actions">
                                            <a href="#" class="action-btn action-edit" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="#" class="action-btn action-delete" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-admin">
                    <div class="empty-state-icon">
                        <i class="fas fa-folder-open"></i>
                    </div>
                    <h3>No categories yet</h3>
                    <p>Start by adding your first category to organize your products.</p>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn-admin-primary">
                        <i class="fas fa-plus"></i> Add First Category
                    </a>
                </div>
            }
        </div>
    </div>
</section>
