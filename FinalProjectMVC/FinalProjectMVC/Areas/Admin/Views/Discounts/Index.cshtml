@model List<DiscountCodeVM>
@{
    ViewData["Title"] = "Discount Codes";
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-ticket-alt"></i> Discount Codes
                </h1>
                <p class="admin-page-subtitle">Codes customers can enter at checkout</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <div class="admin-breadcrumb">
                    <i class="fas fa-home"></i>
                    <span>Admin</span>
                    <i class="fas fa-chevron-right separator"></i>
                    <span class="current">Discounts</span>
                </div>
                <a asp-area="Admin" asp-controller="Discounts" asp-action="Create" class="btn-admin-primary">
                    <i class="fas fa-plus"></i> Add Code
                </a>
            </div>
        </div>

        <div class="admin-table-wrapper mt-4">
            <div class="admin-table-header">
                <h3>
                    All Codes
                    <span class="badge-count">@(ViewData.GetPager()?.TotalItems ?? Model.Count)</span>
                </h3>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Discount</th>
                                <th>Min. Order</th>
                                <th>Uses</th>
                                <th>Expires</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var code in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="discount-code-chip">@code.Code</span>
                                        @if (!string.IsNullOrEmpty(code.Description))
                                        {
                                            <small class="d-block text-muted mt-1">@code.Description</small>
                                        }
                                    </td>
                                    <td><strong>@code.ValueDisplay</strong></td>
                                    <td>@(code.MinOrderAmount.HasValue ? $"${code.MinOrderAmount.Value:F2}" : "—")</td>
                                    <td class="text-nowrap">
                                        @code.UsedCount @(code.MaxUses.HasValue ? $"/ {code.MaxUses}" : "/ ∞")
                                    </td>
                                    <td class="text-nowrap">
                                        @if (code.ExpiresAt.HasValue)
                                        {
                                            @DateTime.SpecifyKind(code.ExpiresAt.Value, DateTimeKind.Utc).ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!code.IsActive)
                                        {
                                            <span class="status-badge status-inactive"><i class="fas fa-pause-circle"></i> Inactive</span>
                                        }
                                        else if (code.IsExpired)
                                        {
                                            <span class="status-badge status-inactive"><i class="fas fa-clock"></i> Expired</span>
                                        }
                                        else if (code.IsUsedUp)
                                        {
                                            <span class="status-badge status-inactive"><i class="fas fa-ban"></i> Used up</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-active"><i class="fas fa-check-circle"></i> Active</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="admin-actions">
                                            <a asp-area="Admin" asp-controller="Discounts" asp-action="Edit" asp-route-id="@code.Id"
                                               class="action-btn action-edit" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-area="Admin" asp-controller="Discounts" asp-action="ToggleActive" asp-route-id="@code.Id"
                                                  method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn action-view" title="@(code.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="fas fa-toggle-@(code.IsActive ? "on" : "off")"></i>
                                                </button>
                                            </form>
                                            <form asp-area="Admin" asp-controller="Discounts" asp-action="Delete" asp-route-id="@code.Id"
                                                  method="post" style="display:inline;"
                                                  onsubmit="return confirm('Delete code @code.Code? Past orders keep their discount.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn action-delete" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pagination" />
            }
            else
            {
                <div class="empty-state-admin">
                    <div class="empty-state-icon">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <h3>No discount codes yet</h3>
                    <p>Create a code like SWEET10 to give customers a discount at checkout.</p>
                    <a asp-area="Admin" asp-controller="Discounts" asp-action="Create" class="btn-admin-primary">
                        <i class="fas fa-plus"></i> Add First Code
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .discount-code-chip {
        display: inline-block;
        font-family: monospace;
        font-weight: 700;
        letter-spacing: 1px;
        background: #FFF4E5;
        color: #8B4513;
        border: 1px dashed #D4A574;
        border-radius: 6px;
        padding: 3px 10px;
    }
</style>
