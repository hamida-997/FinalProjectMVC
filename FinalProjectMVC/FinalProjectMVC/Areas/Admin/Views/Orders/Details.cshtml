@model OrderVM
@{
    ViewData["Title"] = $"Order #{Model.Id}";

    string Label(OrderStatus s) => OrderStatusText.Label(s);

    var steps = new[] { OrderStatus.Pending, OrderStatus.Confirmed, OrderStatus.Preparing,
                        OrderStatus.ReadyForPickup, OrderStatus.OutForDelivery, OrderStatus.Delivered };
    var stepIcons = new[] { "fa-clock", "fa-check", "fa-blender", "fa-box", "fa-truck", "fa-home" };
    var isCancelled = Model.Status == OrderStatus.Cancelled;
    var currentStep = Array.IndexOf(steps, Model.Status);
    var isOpen = Model.Status != OrderStatus.Delivered && !isCancelled;
    var itemCount = Model.OrderItems.Sum(i => i.Quantity);
}

<section class="admin-page-section order-details-page">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-receipt"></i> Order #@Model.Id
                </h1>
                <p class="admin-page-subtitle">
                    Placed on @Model.OrderDate.ToString("MMMM dd, yyyy") at @Model.OrderDate.ToString("HH:mm")
                </p>
            </div>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="admin-breadcrumb">
                    <i class="fas fa-home"></i>
                    <span>Admin</span>
                    <i class="fas fa-chevron-right separator"></i>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a>
                    <i class="fas fa-chevron-right separator"></i>
                    <span class="current">#@Model.Id</span>
                </div>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn-admin-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Orders
                </a>
            </div>
        </div>

        <!-- Summary strip -->
        <div class="od-stats">
            <div class="od-stat">
                <span class="od-stat-label">Status</span>
                <span class="order-status order-status-@Model.Status.ToString().ToLower()">@Model.StatusName</span>
            </div>
            <div class="od-stat">
                <span class="od-stat-label">Payment</span>
                <span class="payment-badge payment-@Model.PaymentStatusName.ToLower()">
                    <i class="fas @(Model.IsPaid ? "fa-check-circle" : "fa-clock")"></i>
                    @Model.PaymentStatusName
                </span>
            </div>
            <div class="od-stat">
                <span class="od-stat-label">Items</span>
                <span class="od-stat-value">@itemCount</span>
            </div>
            <div class="od-stat">
                <span class="od-stat-label">Total</span>
                <span class="od-stat-value od-total">$@Model.TotalAmount.ToString("F2")</span>
            </div>
        </div>

        <!-- Progress -->
        <div class="admin-panel od-progress-panel">
            <div class="admin-panel-body">
                @if (isCancelled)
                {
                    <div class="od-cancelled">
                        <i class="fas fa-ban"></i>
                        <div>
                            <strong>This order was cancelled.</strong>
                            @if (Model.IsPaid)
                            {
                                <span>It was paid, so refund it from the Stripe Dashboard.</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <ol class="od-steps">
                        @for (var i = 0; i < steps.Length; i++)
                        {
                            var state = i < currentStep ? "done" : i == currentStep ? "current" : "";
                            <li class="od-step @state">
                                <span class="od-step-dot">
                                    <i class="fas @(i < currentStep ? "fa-check" : stepIcons[i])"></i>
                                </span>
                                <span class="od-step-label">@Label(steps[i])</span>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>

        <div class="row g-4">
            <!-- Main column -->
            <div class="col-lg-8">
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3>
                            <i class="fas fa-box"></i> Order Items
                            <span class="badge-count ms-2">@Model.OrderItems.Count</span>
                        </h3>
                    </div>
                    <div class="table-responsive">
                        <table class="admin-table od-items">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="od-product">
                                                <span class="od-product-icon"><i class="fas fa-birthday-cake"></i></span>
                                                <div>
                                                    <strong>@item.ProductName</strong>
                                                    <small class="d-block text-muted">Product #@item.ProductId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center"><span class="od-qty">× @item.Quantity</span></td>
                                        <td class="text-end">$@item.UnitPrice.ToString("F2")</td>
                                        <td class="text-end"><strong class="price-value">$@item.TotalPrice.ToString("F2")</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="od-totals">
                        <div class="od-totals-row">
                            <span>Subtotal</span>
                            <span>$@Model.Subtotal.ToString("F2")</span>
                        </div>
                        @if (Model.HasDiscount)
                        {
                            <div class="od-totals-row od-discount">
                                <span>
                                    Discount
                                    @if (!string.IsNullOrEmpty(Model.DiscountCode))
                                    {
                                        <code>@Model.DiscountCode</code>
                                    }
                                </span>
                                <span>−$@Model.DiscountAmount.ToString("F2")</span>
                            </div>
                        }
                        <div class="od-totals-row od-grand">
                            <span>@(Model.IsPaid ? "Total Paid" : "Total")</span>
                            <span>$@Model.TotalAmount.ToString("F2")</span>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mt-0">
                    <!-- Customer -->
                    <div class="col-md-6">
                        <div class="admin-panel">
                            <div class="admin-panel-header">
                                <h3><i class="fas fa-user"></i> Customer</h3>
                            </div>
                            <div class="admin-panel-body">
                                <div class="customer-info-item">
                                    <i class="fas fa-user"></i>
                                    <div>
                                        <small>Name</small>
                                        <strong>@Model.CustomerName</strong>
                                    </div>
                                </div>
                                <div class="customer-info-item">
                                    <i class="fas fa-envelope"></i>
                                    <div>
                                        <small>Email</small>
                                        <strong><a href="mailto:@Model.CustomerEmail" class="od-link">@Model.CustomerEmail</a></strong>
                                    </div>
                                </div>
                                <div class="customer-info-item">
                                    <i class="fas fa-phone"></i>
                                    <div>
                                        <small>Phone</small>
                                        <strong>
                                            @if (string.IsNullOrEmpty(Model.CustomerPhone))
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                <a href="tel:@Model.CustomerPhone" class="od-link">@Model.CustomerPhone</a>
                                            }
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Delivery -->
                    <div class="col-md-6">
                        <div class="admin-panel">
                            <div class="admin-panel-header">
                                <h3><i class="fas fa-truck"></i> Delivery</h3>
                            </div>
                            <div class="admin-panel-body">
                                <div class="customer-info-item">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <div>
                                        <small>Address</small>
                                        <strong class="od-prewrap">@Model.ShippingAddress</strong>
                                    </div>
                                </div>
                                <div class="customer-info-item">
                                    <i class="fas fa-calendar-check"></i>
                                    <div>
                                        <small>Delivery Date</small>
                                        <strong>@(Model.DeliveryDate.HasValue ? Model.DeliveryDate.Value.ToString("MMM dd, yyyy") : "Not set")</strong>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                                {
                                    <div class="customer-info-item">
                                        <i class="fas fa-sticky-note"></i>
                                        <div>
                                            <small>Customer Notes</small>
                                            <strong class="od-prewrap od-notes">@Model.Notes</strong>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="od-sidebar">
                    <!-- Status -->
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h3><i class="fas fa-flag"></i> Manage Order</h3>
                        </div>
                        <div class="admin-panel-body">
                            @if (isOpen)
                            {
                                <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />

                                    <div class="form-group-admin">
                                        <label class="form-label-admin" for="statusSelect">Change status to</label>
                                        <select name="status" id="statusSelect" class="form-control-admin" required>
                                            @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                                            {
                                                // Cancelling has its own button below
                                                if (status != Model.Status && status != OrderStatus.Cancelled)
                                                {
                                                    var isNext = (int)status == (int)Model.Status + 1;
                                                    if (isNext)
                                                    {
                                                        <option value="@status" selected>@Label(status) (next)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@status">@Label(status)</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="form-group-admin">
                                        <label class="form-label-admin" for="deliveryDate">Delivery date <span class="text-muted fw-normal">(optional)</span></label>
                                        <input type="date" name="deliveryDate" id="deliveryDate" class="form-control-admin"
                                               value="@(Model.DeliveryDate?.ToString("yyyy-MM-dd"))" />
                                    </div>

                                    <button type="submit" class="btn-admin-primary w-100 justify-content-center">
                                        <i class="fas fa-check"></i> Update Status
                                    </button>
                                </form>

                                <div class="od-divider"><span>or</span></div>

                                <form asp-area="Admin" asp-controller="Orders" asp-action="Cancel" method="post"
                                      onsubmit="return confirm('Are you sure you want to cancel order #@Model.Id?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn-od-cancel">
                                        <i class="fas fa-ban"></i> Cancel Order
                                    </button>
                                </form>
                                @if (Model.IsPaid)
                                {
                                    <p class="od-hint"><i class="fas fa-info-circle"></i> This order is paid. Cancelling it here does not refund the customer.</p>
                                }
                            }
                            else
                            {
                                <div class="od-closed">
                                    <i class="fas @(isCancelled ? "fa-ban" : "fa-check-circle")"></i>
                                    <p class="mb-0">
                                        This order is <strong>@Model.StatusName.ToLower()</strong> and can no longer be changed.
                                    </p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Payment -->
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h3><i class="fas fa-credit-card"></i> Payment</h3>
                        </div>
                        <div class="admin-panel-body">
                            <div class="od-kv">
                                <span>Status</span>
                                <span class="payment-badge payment-@Model.PaymentStatusName.ToLower()">
                                    <i class="fas @(Model.IsPaid ? "fa-check-circle" : "fa-clock")"></i>
                                    @Model.PaymentStatusName
                                </span>
                            </div>
                            <div class="od-kv">
                                <span>Method</span>
                                <span><i class="fab fa-stripe"></i> Stripe</span>
                            </div>
                            <div class="od-kv">
                                <span>Paid on</span>
                                <span>@(Model.PaidAt.HasValue ? Model.PaidAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm") : "—")</span>
                            </div>
                            <div class="od-kv">
                                <span>Amount</span>
                                <strong>$@Model.TotalAmount.ToString("F2")</strong>
                            </div>
                            @if (Model.IsPaid && isCancelled)
                            {
                                <div class="od-warning">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    Cancelled but paid. Refund it from the Stripe Dashboard.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_PaymentBadgeStyles" />

<style>
    /* The global .admin-panel has height:100%, which stretches stacked panels on this page */
    .order-details-page .admin-panel { height: auto; }

    /* Summary strip */
    .od-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin: 20px 0;
    }
    .od-stat {
        background: #fff;
        border-radius: 15px;
        box-shadow: var(--shadow);
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
    }
    .od-stat-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-light); font-weight: 600; }
    .od-stat-value { font-size: 1.4rem; font-weight: 700; color: var(--text-dark); line-height: 1.2; }
    .od-total { color: var(--secondary-color); font-family: 'Georgia', serif; }

    /* Progress */
    .od-progress-panel { margin-bottom: 24px; }
    .od-steps { list-style: none; display: flex; margin: 0; padding: 0; }
    .od-step { flex: 1; position: relative; text-align: center; }
    .od-step::before {
        content: ''; position: absolute; top: 20px; left: -50%; width: 100%; height: 3px; background: #F0E6D9; z-index: 0;
    }
    .od-step:first-child::before { display: none; }
    .od-step.done::before, .od-step.current::before { background: var(--primary-color); }
    .od-step-dot {
        position: relative; z-index: 1; width: 42px; height: 42px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        background: #fff; border: 3px solid #F0E6D9; color: #C9B8A6;
    }
    .od-step.done .od-step-dot { background: var(--primary-color); border-color: var(--primary-color); color: #fff; }
    .od-step.current .od-step-dot {
        background: var(--secondary-color); border-color: var(--secondary-color); color: #fff;
        box-shadow: 0 0 0 5px rgba(139, 69, 19, 0.15);
    }
    .od-step-label { display: block; margin-top: 8px; font-size: 0.85rem; color: var(--text-light); }
    .od-step.done .od-step-label, .od-step.current .od-step-label { color: var(--text-dark); font-weight: 600; }

    .od-cancelled { display: flex; gap: 14px; align-items: center; color: #991B1B; }
    .od-cancelled i { font-size: 1.6rem; }
    .od-cancelled span { display: block; color: #7f1d1d; font-size: 0.9rem; }

    /* Items */
    .od-items { margin: 0; }
    .od-product { display: flex; align-items: center; gap: 12px; }
    .od-product-icon {
        width: 42px; height: 42px; border-radius: 10px; flex-shrink: 0;
        background: var(--bg-cream); color: var(--primary-color);
        display: inline-flex; align-items: center; justify-content: center;
    }
    .od-qty { background: var(--bg-cream); border-radius: 20px; padding: 3px 12px; font-weight: 600; font-size: 0.9rem; }

    .od-totals { border-top: 1px solid #F0E6D9; padding: 18px 25px; background: #FFFCF8; }
    .od-totals-row { display: flex; justify-content: space-between; padding: 5px 0; color: var(--text-dark); max-width: 340px; margin-left: auto; }
    .od-totals-row code { background: #ECFDF5; color: #065F46; padding: 1px 6px; border-radius: 4px; margin-left: 4px; }
    .od-discount { color: #10B981; font-weight: 600; }
    .od-grand {
        border-top: 1px dashed #E6D5C3; margin-top: 6px; padding-top: 12px;
        font-weight: 700; font-size: 1.15rem;
    }
    .od-grand span:last-child { color: var(--secondary-color); font-family: 'Georgia', serif; font-size: 1.35rem; }

    /* Info panels */
    .od-link { color: var(--secondary-color); text-decoration: none; word-break: break-all; }
    .od-link:hover { text-decoration: underline; }
    .od-prewrap { white-space: pre-line; word-break: break-word; }
    .od-notes { font-weight: 500; font-style: italic; }

    /* Sidebar */
    .od-sidebar { position: sticky; top: 90px; display: flex; flex-direction: column; gap: 24px; }

    .od-divider { display: flex; align-items: center; gap: 10px; color: var(--text-light); font-size: 0.8rem; margin: 16px 0; }
    .od-divider::before, .od-divider::after { content: ''; flex: 1; height: 1px; background: #F0E6D9; }

    .btn-od-cancel {
        width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        background: #fff; color: #DC3545; border: 2px solid #F5C2C7; border-radius: 10px;
        padding: 11px 20px; font-weight: 600; transition: all 0.2s ease;
    }
    .btn-od-cancel:hover { background: #DC3545; border-color: #DC3545; color: #fff; }

    .od-hint { font-size: 0.82rem; color: var(--text-light); margin: 10px 0 0; }

    .od-closed { text-align: center; color: var(--text-light); padding: 10px 0; }
    .od-closed i { font-size: 2rem; color: var(--primary-color); margin-bottom: 10px; display: block; }

    .od-kv { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #F8F4EE; font-size: 0.95rem; }
    .od-kv:last-of-type { border-bottom: none; }
    .od-kv span:first-child { color: var(--text-light); }

    .od-warning {
        margin-top: 12px; background: #FEF3C7; color: #92400E; border-radius: 10px;
        padding: 10px 14px; font-size: 0.88rem;
    }

    @@media (max-width: 991px) {
        .od-sidebar { position: static; }
    }

    @@media (max-width: 767px) {
        .od-stats { grid-template-columns: repeat(2, 1fr); }
        .od-steps { flex-direction: column; gap: 14px; }
        .od-step { display: flex; align-items: center; gap: 12px; text-align: left; }
        .od-step::before { display: none; }
        .od-step-label { margin-top: 0; }
    }
</style>
