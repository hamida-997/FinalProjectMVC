@model OrderVM
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-receipt"></i> Order #@Model.Id
                </h1>
                <p class="admin-page-subtitle">
                    Placed on @Model.OrderDate.ToString("MMMM dd, yyyy") at @Model.OrderDate.ToString("HH:mm")
                </p>
            </div>
            <div class="admin-breadcrumb">
                <i class="fas fa-home"></i>
                <span>Admin</span>
                <i class="fas fa-chevron-right separator"></i>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a>
                <i class="fas fa-chevron-right separator"></i>
                <span class="current">#@Model.Id</span>
            </div>
        </div>

        <div class="row g-4 mt-2">
            <!-- Order Items -->
            <div class="col-lg-8">
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3>
                            <i class="fas fa-box"></i> Order Items
                            <span class="badge-count ms-2">@Model.OrderItems.Count</span>
                        </h3>
                    </div>
                    <div class="admin-panel-body" style="padding: 0;">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.ProductName</strong>
                                            <small class="d-block text-muted">Product #@item.ProductId</small>
                                        </td>
                                        <td><span class="category-badge">@item.Quantity</span></td>
                                        <td>$@item.UnitPrice.ToString("F2")</td>
                                        <td class="text-end"><strong class="price-value">$@item.TotalPrice.ToString("F2")</strong></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr style="background: var(--bg-cream);">
                                    <td colspan="3" class="text-end"><strong>Total Amount:</strong></td>
                                    <td class="text-end">
                                        <strong style="color: var(--secondary-color); font-size: 1.3rem; font-family: 'Georgia', serif;">
                                            $@Model.TotalAmount.ToString("F2")
                                        </strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="admin-panel mt-4">
                        <div class="admin-panel-header">
                            <h3><i class="fas fa-sticky-note"></i> Order Notes</h3>
                        </div>
                        <div class="admin-panel-body">
                            <p class="mb-0">@Model.Notes</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Status Panel -->
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="fas fa-flag"></i> Order Status</h3>
                    </div>
                    <div class="admin-panel-body">
                        <div class="current-status-display mb-3">
                            <span class="order-status order-status-@Model.Status.ToString().ToLower()" style="font-size: 1rem; padding: 8px 16px;">
                                @Model.StatusName
                            </span>
                        </div>

                        @if (Model.Status != OrderStatus.Delivered && Model.Status != OrderStatus.Cancelled)
                        {
                            <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />

                                <div class="form-group-admin">
                                    <label class="form-label-admin">Update Status</label>
                                    <select name="status" class="form-control-admin" required>
                                        @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                                        {
                                            if (status != Model.Status)
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="form-group-admin">
                                    <label class="form-label-admin">Delivery Date (optional)</label>
                                    <input type="date" name="deliveryDate" class="form-control-admin"
                                           value="@(Model.DeliveryDate?.ToString("yyyy-MM-dd"))" />
                                </div>

                                <button type="submit" class="btn-admin-primary w-100">
                                    <i class="fas fa-check"></i> Update Status
                                </button>
                            </form>

                            <form asp-area="Admin" asp-controller="Orders" asp-action="Cancel" method="post" class="mt-3"
                                  onsubmit="return confirm('Are you sure you want to cancel this order?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn-admin-danger w-100">
                                    <i class="fas fa-ban"></i> Cancel Order
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <!-- Customer Info -->
                <div class="admin-panel mt-4">
                    <div class="admin-panel-header">
                        <h3><i class="fas fa-user"></i> Customer</h3>
                    </div>
                    <div class="admin-panel-body">
                        <div class="customer-info-item">
                            <i class="fas fa-user"></i>
                            <div>
                                <small>Name</small>
                                <strong>@Model.CustomerName</strong>
                            </div>
                        </div>
                        <div class="customer-info-item">
                            <i class="fas fa-envelope"></i>
                            <div>
                                <small>Email</small>
                                <strong>@Model.CustomerEmail</strong>
                            </div>
                        </div>
                        <div class="customer-info-item">
                            <i class="fas fa-phone"></i>
                            <div>
                                <small>Phone</small>
                                <strong>@Model.CustomerPhone</strong>
                            </div>
                        </div>
                        <div class="customer-info-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <div>
                                <small>Address</small>
                                <strong>@Model.ShippingAddress</strong>
                            </div>
                        </div>
                        @if (Model.DeliveryDate.HasValue)
                        {
                            <div class="customer-info-item">
                                <i class="fas fa-calendar-check"></i>
                                <div>
                                    <small>Delivery Date</small>
                                    <strong>@Model.DeliveryDate.Value.ToString("MMM dd, yyyy")</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
