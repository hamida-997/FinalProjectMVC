@model List<OrderVM>
@{
    ViewData["Title"] = "Orders";
    var selectedStatus = ViewBag.SelectedStatus as OrderStatus?;
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-shopping-bag"></i> Orders
                </h1>
                <p class="admin-page-subtitle">Manage customer orders</p>
            </div>
            <div class="admin-breadcrumb">
                <i class="fas fa-home"></i>
                <span>Admin</span>
                <i class="fas fa-chevron-right separator"></i>
                <span class="current">Orders</span>
            </div>
        </div>

        <!-- Status Filter Pills -->
        <div class="status-filter-bar mt-3">
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
               class="status-pill @(selectedStatus == null ? "active" : "")">
                All
            </a>
            @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
            {
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="@status"
                   class="status-pill @(selectedStatus == status ? "active" : "")">
                    @OrderStatusText.Label(status)
                </a>
            }
        </div>

        <!-- Table -->
        <div class="admin-table-wrapper mt-4">
            <div class="admin-table-header">
                <h3>
                    @(selectedStatus.HasValue ? $"{OrderStatusText.Label(selectedStatus.Value)} Orders" : "All Orders")
                    <span class="badge-count">@(ViewData.GetPager()?.TotalItems ?? Model.Count)</span>
                </h3>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Already sorted newest-first by the controller, before paging *@
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong>#@order.Id</strong></td>
                                    <td>
                                        <strong>@order.CustomerName</strong>
                                        <small class="d-block text-muted">@order.CustomerEmail</small>
                                    </td>
                                    <td>
                                        <span class="category-badge">@order.OrderItems.Sum(i => i.Quantity) item@(order.OrderItems.Sum(i => i.Quantity) != 1 ? "s" : "")</span>
                                    </td>
                                    <td>
                                        <strong class="price-value">$@order.TotalAmount.ToString("F2")</strong>
                                        @if (order.HasDiscount)
                                        {
                                            <small class="d-block" style="color: #10B981;" title="Subtotal $@order.Subtotal.ToString("F2")">
                                                <i class="fas fa-ticket-alt"></i> @order.DiscountCode −$@order.DiscountAmount.ToString("F2")
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <span class="order-status order-status-@order.Status.ToString().ToLower()">
                                            @order.StatusName
                                        </span>
                                    </td>
                                    <td>
                                        <span class="payment-badge payment-@order.PaymentStatusName.ToLower()">
                                            <i class="fas @(order.IsPaid ? "fa-check-circle" : "fa-clock")"></i>
                                            @order.PaymentStatusName
                                        </span>
                                    </td>
                                    <td>
                                        @order.OrderDate.ToString("MMM dd, yyyy")
                                        <small class="d-block text-muted">@order.OrderDate.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-end">
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                                           class="action-btn action-view" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pagination" />
            }
            else
            {
                <div class="empty-state-admin">
                    <div class="empty-state-icon">
                        <i class="fas fa-shopping-bag"></i>
                    </div>
                    <h3>No orders found</h3>
                    <p>@(selectedStatus.HasValue ? $"No {OrderStatusText.Label(selectedStatus.Value).ToLower()} orders at this time." : "No orders have been placed yet.")</p>
                </div>
            }
        </div>
    </div>
</section>

<partial name="_PaymentBadgeStyles" />
