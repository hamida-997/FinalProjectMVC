@model UpdateProductVM
@{
    ViewData["Title"] = "Edit Product";
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-edit"></i> Edit Product
                </h1>
                <p class="admin-page-subtitle">Update product information</p>
            </div>
            <div class="admin-breadcrumb">
                <i class="fas fa-home"></i>
                <span>Admin</span>
                <i class="fas fa-chevron-right separator"></i>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a>
                <i class="fas fa-chevron-right separator"></i>
                <span class="current">Edit</span>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div class="row g-4 mt-2">
                <!-- Main Info -->
                <div class="col-lg-8">
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h3><i class="fas fa-info-circle"></i> Product Information</h3>
                        </div>
                        <div class="admin-panel-body">
                            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                            {
                                <div class="alert-danger mb-3">
                                    <i class="fas fa-exclamation-circle me-2"></i>
                                    <div asp-validation-summary="ModelOnly"></div>
                                </div>
                            }

                            <div class="form-group-admin">
                                <label asp-for="Name" class="form-label-admin"></label>
                                <input asp-for="Name" class="form-control-admin" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group-admin">
                                <label asp-for="Description" class="form-label-admin"></label>
                                <textarea asp-for="Description" class="form-control-admin" rows="5"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group-admin">
                                        <label asp-for="Price" class="form-label-admin"></label>
                                        <div class="input-with-prefix">
                                            <span class="input-prefix">$</span>
                                            <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control-admin" />
                                        </div>
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group-admin">
                                        <label asp-for="StockQuantity" class="form-label-admin"></label>
                                        <input asp-for="StockQuantity" type="number" min="0" class="form-control-admin" />
                                        <span asp-validation-for="StockQuantity" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="col-lg-4">
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h3><i class="fas fa-cog"></i> Settings</h3>
                        </div>
                        <div class="admin-panel-body">
                            <div class="form-group-admin">
                                <label asp-for="CategoryId" class="form-label-admin"></label>
                                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control-admin">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="form-group-admin">
                                <div class="form-check-admin">
                                    <input asp-for="IsAvailable" class="form-check-input-admin" />
                                    <label asp-for="IsAvailable" class="form-check-label-admin">
                                        Available for Sale
                                        <small>(Visible to customers)</small>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="admin-panel mt-4">
                        <div class="admin-panel-header">
                            <h3><i class="fas fa-exclamation-triangle"></i> Danger Zone</h3>
                        </div>
                        <div class="admin-panel-body">
                            <p class="text-muted mb-3">
                                Deleting a product is permanent. Make sure it has no associated orders.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions-full">
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn-admin-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button type="submit" class="btn-admin-primary">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>

        <!-- Delete form (outside main form to avoid nested forms) -->
        <div class="form-actions-full mt-3" style="justify-content: flex-start; background: #FFF5F5; border: 1px solid #FFE0E0;">
            <form asp-area="Admin" asp-controller="Products" asp-action="Delete" method="post"
                  onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-admin-danger">
                    <i class="fas fa-trash-alt"></i> Delete Product
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
