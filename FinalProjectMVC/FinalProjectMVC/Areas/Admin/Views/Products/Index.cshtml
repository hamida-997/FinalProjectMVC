@model List<ProductVM>
@{
    ViewData["Title"] = "Products";
    var all = ViewBag.AllProducts as List<ProductVM> ?? Model;
    var search = ViewBag.Search as string;
    var stock = ViewBag.Stock as string;
    var isFiltered = !string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(stock);
    var stockLabel = stock switch { "out" => "Out of Stock", "low" => "Low Stock", "available" => "Available", "hidden" => "Hidden", _ => null };
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-cookie-bite"></i> Products
                </h1>
                <p class="admin-page-subtitle">Manage your bakery products</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <div class="admin-breadcrumb">
                    <i class="fas fa-home"></i>
                    <span>Admin</span>
                    <i class="fas fa-chevron-right separator"></i>
                    <span class="current">Products</span>
                </div>
                <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn-admin-primary">
                    <i class="fas fa-plus"></i> Add Product
                </a>
            </div>
        </div>

        <!-- Stats Row (click a card to filter) -->
        <div class="row g-3 mt-3">
            <div class="col-md-3 col-6">
                <a asp-action="Index" asp-route-search="@search" class="mini-stat-card mini-stat-link @(string.IsNullOrEmpty(stock) ? "active" : "")">
                    <span class="mini-stat-label">Total</span>
                    <span class="mini-stat-value">@all.Count</span>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a asp-action="Index" asp-route-search="@search" asp-route-stock="available" class="mini-stat-card mini-stat-link @(stock == "available" ? "active" : "")">
                    <span class="mini-stat-label">Available</span>
                    <span class="mini-stat-value text-success">@all.Count(p => p.IsAvailable)</span>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a asp-action="Index" asp-route-search="@search" asp-route-stock="out" class="mini-stat-card mini-stat-link @(stock == "out" ? "active" : "")">
                    <span class="mini-stat-label">Out of Stock</span>
                    <span class="mini-stat-value text-danger">@all.Count(p => p.StockQuantity == 0)</span>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a asp-action="Index" asp-route-search="@search" asp-route-stock="low" class="mini-stat-card mini-stat-link @(stock == "low" ? "active" : "")">
                    <span class="mini-stat-label">Low Stock</span>
                    <span class="mini-stat-value text-warning">@all.Count(p => p.StockQuantity > 0 && p.StockQuantity < 10)</span>
                </a>
            </div>
        </div>

        <!-- Table -->
        <div class="admin-table-wrapper mt-4">
            <div class="admin-table-header">
                <h3>
                    @(stockLabel ?? "All") Products
                    <span class="badge-count">@(ViewData.GetPager()?.TotalItems ?? Model.Count)</span>
                </h3>
                <form method="get" asp-action="Index" class="product-search">
                    @if (!string.IsNullOrEmpty(stock))
                    {
                        <input type="hidden" name="stock" value="@stock" />
                    }
                    <i class="fas fa-search"></i>
                    <input type="search" name="search" value="@search" placeholder="Name or category..." class="form-control-admin" />
                    @if (isFiltered)
                    {
                        <a asp-action="Index" class="btn-admin-secondary" title="Clear filters"><i class="fas fa-times"></i> Clear</a>
                    }
                </form>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>
                                        @{
                                            var primaryImage = product.Images.FirstOrDefault(i => i.IsPrimary);
                                            if (primaryImage == null)
                                            {
                                                primaryImage = product.Images.FirstOrDefault();
                                            }
                                        }
                                        <div class="product-thumb">
                                            @if (primaryImage != null)
                                            {
                                                <img src="@primaryImage.ImageUrl" alt="@product.Name" />
                                            }
                                            else
                                            {
                                                <i class="fas fa-cookie-bite"></i>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <strong>@product.Name</strong>
                                        <small class="d-block text-muted">#@product.Id</small>
                                    </td>
                                    <td>
                                        <span class="category-badge">@product.CategoryName</span>
                                    </td>
                                    <td>
                                        <strong class="price-value">$@product.Price.ToString("F2")</strong>
                                    </td>
                                    <td>
                                        @if (product.StockQuantity == 0)
                                        {
                                            <span class="stock-indicator-small out-of-stock">
                                                <i class="fas fa-times-circle"></i> 0
                                            </span>
                                        }
                                        else if (product.StockQuantity < 10)
                                        {
                                            <span class="stock-indicator-small low-stock">
                                                <i class="fas fa-exclamation-circle"></i> @product.StockQuantity
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="stock-indicator-small in-stock">
                                                <i class="fas fa-check-circle"></i> @product.StockQuantity
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (product.IsAvailable)
                                        {
                                            <span class="status-badge status-active">
                                                <i class="fas fa-check-circle"></i> Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <i class="fas fa-pause-circle"></i> Hidden
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="admin-actions">
                                            <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                                               class="action-btn action-view" title="View" target="_blank">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-area="Admin" asp-controller="Products" asp-action="Images" asp-route-id="@product.Id"
                                               class="action-btn action-images" title="Images">
                                                <i class="fas fa-images"></i>
                                            </a>
                                            <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id"
                                               class="action-btn action-edit" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-area="Admin" asp-controller="Products" asp-action="Delete" method="post"
                                                  style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@product.Id" />
                                                <button type="submit" class="action-btn action-delete" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pagination" />
            }
            else
            {
                <div class="empty-state-admin">
                    <div class="empty-state-icon">
                        <i class="fas fa-cookie-bite"></i>
                    </div>
                    @if (isFiltered)
                    {
                        <h3>No matching products</h3>
                        <p>No products match these filters.</p>
                        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn-admin-secondary">
                            <i class="fas fa-redo"></i> Clear Filters
                        </a>
                    }
                    else
                    {
                        <h3>No products yet</h3>
                        <p>Start by adding your first product to the bakery.</p>
                        <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn-admin-primary">
                            <i class="fas fa-plus"></i> Add First Product
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</section>

<style>
    .mini-stat-link { display: flex; text-decoration: none; border: 2px solid transparent; }
    .mini-stat-link.active { border-color: var(--primary-color); }

    .admin-table-header { flex-wrap: wrap; gap: 12px; }
    .product-search { position: relative; display: flex; align-items: center; gap: 8px; margin: 0; }
    .product-search > i { position: absolute; left: 14px; color: var(--text-light); pointer-events: none; }
    .product-search input { padding-left: 38px; min-width: 240px; margin: 0; }
    .product-search .btn-admin-secondary { padding: 10px 16px; white-space: nowrap; }
</style>
