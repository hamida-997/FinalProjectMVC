@{
    var currentUser = Context.Session.GetString("UserFirstName") ?? "Admin";
    var userEmail = Context.Session.GetString("UserEmail") ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Caramellize Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Logout is a form button now; make it look like the other sidebar links */
        .logout-btn { width: 100%; background: none; border: none; text-align: left; font: inherit; cursor: pointer; }
    </style>
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-header">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="admin-brand">
                    <i class="fas fa-birthday-cake"></i>
                    <span class="brand-text">Caramellize</span>
                </a>
                <button class="sidebar-close-btn d-lg-none" onclick="toggleSidebar()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <nav class="admin-nav">
                <div class="admin-nav-section">
                    <span class="admin-nav-label">Main</span>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index"
                               class="admin-nav-link @(currentController == "Home" ? "active" : "")">
                                <i class="fas fa-tachometer-alt"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="admin-nav-section">
                    <span class="admin-nav-label">Catalog</span>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                               class="admin-nav-link @(currentController == "Products" ? "active" : "")">
                                <i class="fas fa-cookie-bite"></i>
                                <span>Products</span>
                            </a>
                        </li>
                        <li>
                            <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                               class="admin-nav-link @(currentController == "Categories" ? "active" : "")">
                                <i class="fas fa-th-large"></i>
                                <span>Categories</span>
                            </a>
                        </li>
                        <li>
                            <a asp-area="Admin" asp-controller="Reviews" asp-action="Index"
                               class="admin-nav-link @(currentController == "Reviews" ? "active" : "")">
                                <i class="fas fa-star"></i>
                                <span>Reviews</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="admin-nav-section">
                    <span class="admin-nav-label">Sales</span>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                               class="admin-nav-link @(currentController == "Orders" ? "active" : "")">
                                <i class="fas fa-shopping-bag"></i>
                                <span>Orders</span>
                            </a>
                        </li>
                        <li>
                            <a asp-area="Admin" asp-controller="Discounts" asp-action="Index"
                               class="admin-nav-link @(currentController == "Discounts" ? "active" : "")">
                                <i class="fas fa-ticket-alt"></i>
                                <span>Discounts</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="admin-nav-section">
                    <span class="admin-nav-label">Management</span>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                               class="admin-nav-link @(currentController == "Users" ? "active" : "")">
                                <i class="fas fa-users"></i>
                                <span>Users</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="admin-nav-section">
                    <span class="admin-nav-label">Account</span>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-link">
                                <i class="fas fa-external-link-alt"></i>
                                <span>View Site</span>
                            </a>
                        </li>
                        <li>
                            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-nav-link text-danger-soft logout-btn">
                                    <i class="fas fa-sign-out-alt"></i>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <button class="sidebar-toggle-btn d-lg-none" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>

                <form class="topbar-search" method="get" asp-area="Admin" asp-controller="Products" asp-action="Index" role="search">
                    <i class="fas fa-search"></i>
                    <input type="search" name="search" placeholder="Search products..." class="topbar-search-input"
                           value="@(currentController == "Products" ? Context.Request.Query["search"].ToString() : "")" aria-label="Search products" />
                </form>

                <div class="topbar-actions">
                    <div class="dropdown">
                        <button class="topbar-user" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="topbar-user-avatar">
                                @(string.IsNullOrEmpty(currentUser) ? "A" : currentUser.Substring(0, 1).ToUpper())
                            </div>
                            <div class="topbar-user-info d-none d-md-block">
                                <span class="topbar-user-name">@currentUser</span>
                                <span class="topbar-user-role">@(User.IsInRole("SuperAdmin") ? "Super Admin" : "Administrator")</span>
                            </div>
                            <i class="fas fa-chevron-down d-none d-md-block"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                            <li class="user-dropdown-header">
                                <div class="fw-bold">@currentUser</div>
                                <small class="text-muted">@userEmail</small>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-external-link-alt me-2"></i>View Site
                                </a>
                            </li>
                            <li>
                                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="success-toast" id="successToast">
                        <i class="fas fa-check-circle"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <script>
                        setTimeout(() => {
                            const toast = document.getElementById('successToast');
                            if (toast) toast.remove();
                        }, 3500);
                    </script>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    @* Errors stay longer than success messages, and can be closed *@
                    <div class="success-toast" id="errorToast" style="background: linear-gradient(135deg, #DC3545, #C82333); cursor: pointer;"
                         onclick="this.remove()" title="Click to close">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <script>
                        setTimeout(() => {
                            const toast = document.getElementById('errorToast');
                            if (toast) toast.remove();
                        }, 7000);
                    </script>
                }

                @RenderBody()
            </main>
        </div>

        <!-- Mobile overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
    </div>

    @* jQuery is required by _ValidationScriptsPartial (jquery.validate) on the admin forms *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('open');
            overlay.classList.toggle('show');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
