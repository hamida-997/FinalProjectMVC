@{
    var currentUser = Context.Session.GetString("UserFirstName") ?? "Admin";
    var userEmail = Context.Session.GetString("UserEmail") ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Caramellize Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-header">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="admin-brand">
                    <i class="fas fa-birthday-cake"></i>
                    <span class="brand-text">Caramellize</span>
                </a>
                <button class="sidebar-close-btn d-lg-none" onclick="toggleSidebar()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <nav class="admin-nav">
                <div class="admin-nav-section">
                    <span class="admin-nav-label">Main</span>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index"
                               class="admin-nav-link @(currentController == "Home" ? "active" : "")">
                                <i class="fas fa-tachometer-alt"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="admin-nav-section">
                    <span class="admin-nav-label">Catalog</span>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                               class="admin-nav-link @(currentController == "Products" ? "active" : "")">
                                <i class="fas fa-cookie-bite"></i>
                                <span>Products</span>
                            </a>
                        </li>
                        <li>
                            <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                               class="admin-nav-link @(currentController == "Categories" ? "active" : "")">
                                <i class="fas fa-th-large"></i>
                                <span>Categories</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="admin-nav-section">
                    <span class="admin-nav-label">Sales</span>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                               class="admin-nav-link @(currentController == "Orders" ? "active" : "")">
                                <i class="fas fa-shopping-bag"></i>
                                <span>Orders</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="admin-nav-section">
                    <span class="admin-nav-label">Account</span>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-link">
                                <i class="fas fa-external-link-alt"></i>
                                <span>View Site</span>
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Auth" asp-action="Logout" class="admin-nav-link text-danger-soft">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <button class="sidebar-toggle-btn d-lg-none" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="topbar-search">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search..." class="topbar-search-input" />
                </div>

                <div class="topbar-actions">
                    <button class="topbar-icon-btn" title="Notifications">
                        <i class="fas fa-bell"></i>
                        <span class="notification-dot"></span>
                    </button>

                    <div class="dropdown">
                        <button class="topbar-user" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="topbar-user-avatar">
                                @(string.IsNullOrEmpty(currentUser) ? "A" : currentUser.Substring(0, 1).ToUpper())
                            </div>
                            <div class="topbar-user-info d-none d-md-block">
                                <span class="topbar-user-name">@currentUser</span>
                                <span class="topbar-user-role">Administrator</span>
                            </div>
                            <i class="fas fa-chevron-down d-none d-md-block"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                            <li class="user-dropdown-header">
                                <div class="fw-bold">@currentUser</div>
                                <small class="text-muted">@userEmail</small>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-external-link-alt me-2"></i>View Site
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger" asp-area="" asp-controller="Auth" asp-action="Logout">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="success-toast" id="successToast">
                        <i class="fas fa-check-circle"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <script>
                        setTimeout(() => {
                            const toast = document.getElementById('successToast');
                            if (toast) toast.remove();
                        }, 3500);
                    </script>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="success-toast" id="errorToast" style="background: linear-gradient(135deg, #DC3545, #C82333);">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <script>
                        setTimeout(() => {
                            const toast = document.getElementById('errorToast');
                            if (toast) toast.remove();
                        }, 3500);
                    </script>
                }

                @RenderBody()
            </main>
        </div>

        <!-- Mobile overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('open');
            overlay.classList.toggle('show');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
