@model CreateUserVM
@{
    ViewData["Title"] = "Create User";
    var summaryErrors = ViewData.ModelState[string.Empty]?.Errors;
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-user-plus"></i> Create User
                </h1>
                <p class="admin-page-subtitle">Add a new user to the system</p>
            </div>
            <div class="admin-breadcrumb">
                <i class="fas fa-home"></i>
                <span>Admin</span>
                <i class="fas fa-chevron-right separator"></i>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a>
                <i class="fas fa-chevron-right separator"></i>
                <span class="current">Create</span>
            </div>
        </div>

        @if (summaryErrors != null && summaryErrors.Count > 0)
        {
            <div class="user-form-alert">
                <i class="fas fa-exclamation-circle"></i>
                <div>@foreach (var error in summaryErrors) { <div>@error.ErrorMessage</div> }</div>
            </div>
        }

        <!-- Form -->
        <div class="admin-form-wrapper mt-4">
            <form asp-area="Admin" asp-controller="Users" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row">
                    <!-- Account Information -->
                    <div class="col-md-6">
                        <div class="form-card">
                            <h3 class="form-card-title">
                                <i class="fas fa-user-circle"></i> Account Information
                            </h3>

                            <div class="form-group">
                                <label asp-for="UserName" class="form-label">Username</label>
                                <input asp-for="UserName" class="form-control" placeholder="Enter username" autocomplete="off" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Email" class="form-label">Email Address</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Enter email" autocomplete="off" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Password" class="form-label">Password</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Personal Information -->
                    <div class="col-md-6">
                        <div class="form-card">
                            <h3 class="form-card-title">
                                <i class="fas fa-id-card"></i> Personal Information
                            </h3>

                            <div class="form-group">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="Enter phone number (optional)" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Address" class="form-label">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter address (optional)"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Roles -->
                    <div class="col-12">
                        <div class="form-card">
                            <h3 class="form-card-title">
                                <i class="fas fa-user-tag"></i> User Roles
                            </h3>
                            <partial name="_RoleCheckboxes" model="Model.Roles" />
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="form-actions mt-4">
                    <button type="submit" class="btn-admin-primary">
                        <i class="fas fa-save"></i> Create User
                    </button>
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn-admin-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

<partial name="_UserStyles" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
