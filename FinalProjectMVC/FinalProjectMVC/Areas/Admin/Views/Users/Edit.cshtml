@model UpdateUserVM
@{
    ViewData["Title"] = "Edit User";
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-user-edit"></i> Edit User
                </h1>
                <p class="admin-page-subtitle">Update user information and roles</p>
            </div>
            <div class="admin-breadcrumb">
                <i class="fas fa-home"></i>
                <span>Admin</span>
                <i class="fas fa-chevron-right separator"></i>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a>
                <i class="fas fa-chevron-right separator"></i>
                <span class="current">Edit</span>
            </div>
        </div>

        <!-- User Info Badge -->
        <div class="info-banner mt-4">
            <i class="fas fa-info-circle"></i>
            <div>
                <strong>Editing:</strong> @ViewBag.UserName (@ViewBag.Email)
            </div>
        </div>

        <!-- Form -->
        <div class="admin-form-wrapper mt-3">
            <form asp-area="Admin" asp-controller="Users" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <!-- Personal Information -->
                    <div class="col-md-6">
                        <div class="form-card">
                            <h3 class="form-card-title">
                                <i class="fas fa-id-card"></i> Personal Information
                            </h3>

                            <div class="form-group">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="Enter phone number (optional)" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information -->
                    <div class="col-md-6">
                        <div class="form-card">
                            <h3 class="form-card-title">
                                <i class="fas fa-cog"></i> Additional Information
                            </h3>

                            <div class="form-group">
                                <label asp-for="Address" class="form-label">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="4" placeholder="Enter address (optional)"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Account Status</label>
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                                    <label class="form-check-label" for="isActiveSwitch">
                                        <span id="statusLabel">@(Model.IsActive ? "Active" : "Inactive")</span>
                                    </label>
                                </div>
                                <span asp-validation-for="IsActive" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Roles -->
                    <div class="col-12">
                        <div class="form-card">
                            <h3 class="form-card-title">
                                <i class="fas fa-user-tag"></i> User Roles
                            </h3>

                            <div class="roles-container">
                                @{
                                    var rolesList = ViewBag.Roles as List<string>;
                                    for (int i = 0; i < rolesList.Count; i++)
                                    {
                                        var role = rolesList[i];
                                        var isChecked = Model.Roles.Contains(role);
                                        <div class="form-check role-checkbox">
                                            <input type="checkbox" class="form-check-input" name="Roles[@i]" value="@role" id="role_@role" 
                                                   @(isChecked ? "checked" : "") />
                                            <label class="form-check-label" for="role_@role">
                                                <span class="role-badge role-@role.ToLower()">@role</span>
                                                <span class="role-description">
                                                    @switch (role)
                                                    {
                                                        case "SuperAdmin":
                                                            @:Full system access with all privileges
                                                            break;
                                                        case "Admin":
                                                            @:Manage products, orders, and users
                                                            break;
                                                        case "Customer":
                                                            @:Browse products and place orders
                                                            break;
                                                    }
                                                </span>
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                            <span asp-validation-for="Roles" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="form-actions mt-4">
                    <button type="submit" class="btn-admin-primary">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn-admin-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <a asp-area="Admin" asp-controller="Users" asp-action="ChangePassword" asp-route-id="@Model.Id" class="btn-admin-warning">
                        <i class="fas fa-key"></i> Change Password
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

<style>
    .info-banner {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 15px 20px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 15px;
        font-size: 1rem;
    }

    .info-banner i {
        font-size: 1.5rem;
    }

    .form-switch .form-check-input {
        width: 3em;
        height: 1.5em;
        cursor: pointer;
    }

    .form-switch .form-check-input:checked {
        background-color: #10B981;
        border-color: #10B981;
    }

    .roles-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 15px;
    }

    .role-checkbox {
        padding: 15px;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .role-checkbox:hover {
        border-color: #8B4513;
        background: #FFF9F0;
    }

    .role-checkbox input:checked ~ label {
        font-weight: 600;
    }

    .role-checkbox input:checked ~ label .role-badge {
        transform: scale(1.05);
    }

    .form-check-label {
        display: flex;
        flex-direction: column;
        gap: 8px;
        cursor: pointer;
    }

    .role-description {
        font-size: 0.85rem;
        color: #718096;
    }

    .btn-admin-warning {
        background: linear-gradient(135deg, #ffd89b 0%, #19547b 100%);
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-admin-warning:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(25, 84, 123, 0.3);
        color: white;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('isActiveSwitch').addEventListener('change', function() {
            document.getElementById('statusLabel').textContent = this.checked ? 'Active' : 'Inactive';
        });
    </script>
}
