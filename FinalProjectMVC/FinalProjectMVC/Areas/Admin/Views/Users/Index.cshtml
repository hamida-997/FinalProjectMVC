@model List<UserVM>
@{
    ViewData["Title"] = "Users Management";
}

<section class="admin-page-section">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="admin-page-header">
            <div>
                <h1 class="admin-page-title">
                    <i class="fas fa-users"></i> Users Management
                </h1>
                <p class="admin-page-subtitle">Manage system users and their roles</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <div class="admin-breadcrumb">
                    <i class="fas fa-home"></i>
                    <span>Admin</span>
                    <i class="fas fa-chevron-right separator"></i>
                    <span class="current">Users</span>
                </div>
                <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn-admin-primary">
                    <i class="fas fa-user-plus"></i> Add User
                </a>
            </div>
        </div>

        <!-- Search & Filter -->
        <div class="admin-filters-section mt-4">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-search"></i> Search</label>
                        <input type="text" name="search" class="form-control" placeholder="Search by name, email or username..." value="@ViewBag.Search" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-user-tag"></i> Filter by Role</label>
                        <select name="role" class="form-control">
                            <option value="">All Roles</option>
                            @foreach (var role in ViewBag.Roles as List<string>)
                            {
                                <option value="@role" selected="@(ViewBag.Role == role)">@role</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn-admin-primary w-100">
                        <i class="fas fa-filter"></i> Filter
                    </button>
                </div>
            </form>
        </div>

        <!-- Table -->
        <div class="admin-table-wrapper mt-4">
            <div class="admin-table-header">
                <h3>
                    All Users
                    <span class="badge-count">@Model.Count</span>
                </h3>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Roles</th>
                                <th>Status</th>
                                <th>Joined</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-avatar">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div>
                                                <div class="user-name">@user.FirstName @user.LastName</div>
                                                <div class="user-username">@@@user.UserName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                                    <td>
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="role-badge role-@role.ToLower()">
                                                @role
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="status-badge status-active">
                                                <i class="fas fa-check-circle"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <i class="fas fa-ban"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <div class="admin-actions">
                                            <a asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@user.Id"
                                               class="action-btn action-view" title="Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id"
                                               class="action-btn action-edit" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-area="Admin" asp-controller="Users" asp-action="ChangePassword" asp-route-id="@user.Id"
                                               class="action-btn action-key" title="Change Password">
                                                <i class="fas fa-key"></i>
                                            </a>
                                            <form asp-area="Admin" asp-controller="Users" asp-action="ToggleStatus" method="post"
                                                  style="display:inline;" onsubmit="return confirm('Are you sure you want to toggle this user status?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="action-btn action-toggle" title="Toggle Status">
                                                    <i class="fas fa-toggle-@(user.IsActive ? "on" : "off")"></i>
                                                </button>
                                            </form>
                                            <form asp-area="Admin" asp-controller="Users" asp-action="Delete" method="post"
                                                  style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="action-btn action-delete" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-admin">
                    <div class="empty-state-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h3>No users found</h3>
                    <p>No users match your search criteria.</p>
                    @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Role as string))
                    {
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn-admin-secondary">
                            <i class="fas fa-redo"></i> Clear Filters
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</section>

<style>
    .user-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 16px;
    }

    .user-name {
        font-weight: 600;
        color: #2d3748;
    }

    .user-username {
        font-size: 0.85rem;
        color: #718096;
    }

    .role-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-right: 4px;
        margin-bottom: 4px;
    }

    .role-superadmin {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .role-admin {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .role-customer {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
    }

    .action-key {
        background: linear-gradient(135deg, #ffd89b 0%, #19547b 100%);
    }

    .action-key:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(25, 84, 123, 0.3);
    }

    .action-toggle {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
    }

    .action-toggle:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(168, 237, 234, 0.3);
    }

    .admin-filters-section {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
</style>
