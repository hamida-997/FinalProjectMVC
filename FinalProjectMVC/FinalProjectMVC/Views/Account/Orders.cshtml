@model List<OrderVM>
@{
    ViewData["Title"] = "My Orders";
}

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav class="breadcrumb-nav">
            <a asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i> Home
            </a>
            <i class="fas fa-chevron-right separator"></i>
            <span class="current">My Orders</span>
        </nav>
    </div>
</section>

<section class="cart-section">
    <div class="container">
        <div class="cart-header">
            <h1>My Orders</h1>
            <p>Track your orders and see their payment status.</p>
        </div>

        <div class="account-nav">
            <a asp-action="Profile"><i class="fas fa-user"></i> Profile</a>
            <a asp-action="Orders" class="active"><i class="fas fa-shopping-bag"></i> My Orders</a>
        </div>

        @if (ViewData["Error"] is string error)
        {
            <div class="account-alert"><i class="fas fa-exclamation-circle"></i> @error</div>
        }

        @if (Model.Count == 0)
        {
            <div class="account-card orders-empty">
                <i class="fas fa-shopping-bag d-block"></i>
                <h4>You haven't placed any orders yet</h4>
                <p class="text-muted">When you order something, it will show up here.</p>
                <a asp-controller="Products" asp-action="Index" class="btn-account">
                    <i class="fas fa-store"></i> Start Shopping
                </a>
            </div>
        }
        else
        {
            foreach (var order in Model)
            {
                var itemCount = order.OrderItems.Sum(i => i.Quantity);
                <div class="order-card">
                    <div class="order-card-main">
                        <h5>Order #@order.Id</h5>
                        <small>
                            <i class="far fa-calendar"></i> @order.OrderDate.ToString("MMM d, yyyy HH:mm")
                            &nbsp;·&nbsp; @itemCount @(itemCount == 1 ? "item" : "items")
                        </small>
                    </div>

                    <div class="order-card-badges">
                        <span class="order-status order-status-@order.Status.ToString().ToLower()">@order.StatusName</span>
                        <span class="payment-badge payment-@order.PaymentStatusName.ToLower()">
                            <i class="fas @(order.IsPaid ? "fa-check-circle" : "fa-clock")"></i>
                            @order.PaymentStatusName
                        </span>
                    </div>

                    <div class="order-card-total">$@order.TotalAmount.ToString("F2")</div>

                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn-account-outline">
                        View <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            }
            <div class="account-pager"><partial name="_Pagination" /></div>
        }
    </div>
</section>

<partial name="_AccountStyles" />
