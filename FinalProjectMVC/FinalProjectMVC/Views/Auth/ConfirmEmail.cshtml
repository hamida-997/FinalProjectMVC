@{
    ViewData["Title"] = "Confirm Email";
    var success = ViewData["Success"] is true;
}

<section class="auth-section">
    <div class="container">
        <div class="auth-status-card">
            @if (success)
            {
                <div class="auth-status-icon success"><i class="fas fa-check-circle"></i></div>
                <h1>Email confirmed</h1>
            }
            else
            {
                <div class="auth-status-icon warning"><i class="fas fa-exclamation-triangle"></i></div>
                <h1>Couldn't confirm your email</h1>
            }
            <p class="lead">@ViewData["Message"]</p>

            <div class="auth-status-actions">
                @if (success)
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn-auth-submit text-decoration-none">
                        <i class="fas fa-sign-in-alt"></i> Log In
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="ResendConfirmation" class="btn-auth-submit text-decoration-none">
                        <i class="fas fa-paper-plane"></i> Send a new link
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<partial name="_AuthStatusStyles" />
