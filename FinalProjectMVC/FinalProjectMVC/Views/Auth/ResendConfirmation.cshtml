@{
    ViewData["Title"] = "Resend Confirmation Email";
    var error = ViewData["Error"] as string;
}

<section class="auth-section">
    <div class="container">
        <div class="auth-status-card">
            <div class="auth-status-icon info"><i class="fas fa-paper-plane"></i></div>
            <h1>Resend confirmation email</h1>
            <p>Enter the email you registered with and we'll send a new confirmation link.</p>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert-danger mb-3"><i class="fas fa-exclamation-circle me-2"></i>@error</div>
            }

            <form asp-controller="Auth" asp-action="ResendConfirmation" method="post" class="text-start">
                @Html.AntiForgeryToken()
                <div class="form-floating-custom">
                    <label for="email">Email</label>
                    <div class="input-with-icon">
                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email" id="email" name="email" value="@ViewData["Email"]" class="form-control auth-input"
                               placeholder="your@email.com" required maxlength="100" />
                    </div>
                </div>
                <button type="submit" class="btn-auth-submit">
                    <i class="fas fa-paper-plane"></i> Send Link
                </button>
            </form>

            <a asp-controller="Auth" asp-action="Login" class="auth-link d-block mt-3">
                <i class="fas fa-arrow-left"></i> Back to login
            </a>
        </div>
    </div>
</section>

<partial name="_AuthStatusStyles" />
