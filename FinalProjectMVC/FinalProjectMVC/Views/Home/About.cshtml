@{
    ViewData["Title"] = "About Us";
}

<!-- Page Hero -->
<section class="about-hero">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <span class="section-subtitle">Our Story</span>
                <h1 class="about-hero-title">A Sweet Journey Since 1998</h1>
                <p class="about-hero-text">
                    From a tiny neighborhood bakery to a beloved community favorite, 
                    discover the passion and craft behind every bite at Caramellize.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Our Story Section -->
<section class="section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="story-image-wrapper">
                    <div class="story-image-main">
                        <i class="fas fa-store"></i>
                    </div>
                    <div class="story-image-badge">
                        <span class="badge-number">25+</span>
                        <span class="badge-text">Years of<br>Excellence</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <span class="section-subtitle">Who We Are</span>
                <h2 class="section-heading">Crafting Memories, One Pastry at a Time</h2>
                <p class="section-text">
                    Caramellize was born out of a simple yet powerful idea: that every meal deserves 
                    to end with something extraordinary. Founded by master baker Elena Caramelli in 1998, 
                    our bakery started as a small family-run shop with a big dream.
                </p>
                <p class="section-text">
                    Today, we continue to honor Elena's legacy by using traditional European techniques 
                    combined with locally-sourced, organic ingredients. Every loaf of bread, every 
                    delicate pastry, and every custom cake tells a story of dedication and craftsmanship.
                </p>
                <div class="feature-list">
                    <div class="feature-list-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Family-owned & operated</span>
                    </div>
                    <div class="feature-list-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Traditional European recipes</span>
                    </div>
                    <div class="feature-list-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Locally sourced ingredients</span>
                    </div>
                    <div class="feature-list-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Freshly baked every morning</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision -->
<section class="section section-cream">
    <div class="container">
        <div class="section-title">
            <span class="section-subtitle">Our Purpose</span>
            <h2>Mission & Vision</h2>
            <p>Guided by values that have stood the test of time</p>
        </div>

        <div class="row g-4 mt-4">
            <div class="col-md-6">
                <div class="mission-card">
                    <div class="mission-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h3>Our Mission</h3>
                    <p>
                        To bring joy to every customer through artisan-crafted baked goods, 
                        made with the finest ingredients and timeless techniques. We believe 
                        that great food creates great memories.
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mission-card">
                    <div class="mission-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <h3>Our Vision</h3>
                    <p>
                        To be the heart of our community, a place where families gather, 
                        celebrations begin, and traditions are born. We envision a world 
                        where every day is made sweeter by our creations.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Values -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <span class="section-subtitle">What Drives Us</span>
            <h2>Our Core Values</h2>
            <p>The principles that shape everything we do</p>
        </div>

        <div class="row g-4 mt-4">
            <div class="col-lg-3 col-md-6">
                <div class="value-card">
                    <div class="value-icon-wrapper">
                        <i class="fas fa-leaf"></i>
                    </div>
                    <h4>Quality First</h4>
                    <p>Only the finest ingredients make it into our kitchen. No shortcuts, no compromises.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="value-card">
                    <div class="value-icon-wrapper">
                        <i class="fas fa-hands"></i>
                    </div>
                    <h4>Handcrafted</h4>
                    <p>Every product is made by hand with attention to detail that machines simply cannot replicate.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="value-card">
                    <div class="value-icon-wrapper">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h4>Passion</h4>
                    <p>Our bakers pour their heart into every creation, treating each piece like a work of art.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="value-card">
                    <div class="value-icon-wrapper">
                        <i class="fas fa-users"></i>
                    </div>
                    <h4>Community</h4>
                    <p>We're more than a bakery, we're a gathering place for the people and families we serve.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="section section-cream">
    <div class="container">
        <div class="section-title">
            <span class="section-subtitle">Meet The Team</span>
            <h2>The People Behind The Magic</h2>
            <p>Our talented bakers who make it all possible</p>
        </div>

        <div class="row g-4 mt-4">
            <div class="col-lg-3 col-md-6">
                <div class="team-card">
                    <div class="team-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h4>Elena Caramelli</h4>
                    <span class="team-role">Founder & Head Baker</span>
                    <p>With over 30 years of experience, Elena is the heart and soul of our bakery.</p>
                    <div class="team-social">
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="team-card">
                    <div class="team-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h4>Marco Rossi</h4>
                    <span class="team-role">Pastry Chef</span>
                    <p>Marco brings French pastry techniques to create our delicate signature desserts.</p>
                    <div class="team-social">
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="team-card">
                    <div class="team-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h4>Sofia Dubois</h4>
                    <span class="team-role">Cake Designer</span>
                    <p>Sofia creates stunning custom cakes that make every celebration unforgettable.</p>
                    <div class="team-social">
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="team-card">
                    <div class="team-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h4>James Baker</h4>
                    <span class="team-role">Bread Specialist</span>
                    <p>James crafts our award-winning sourdough and artisan bread collection.</p>
                    <div class="team-social">
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="about-cta">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h2>Ready to Taste the Difference?</h2>
                <p>Visit our bakery today or order online and experience the magic of Caramellize firsthand.</p>
                <div class="cta-buttons">
                    <a asp-controller="Products" asp-action="Index" class="btn-primary-custom">
                        <i class="fas fa-shopping-bag"></i> Shop Now
                    </a>
                    <a href="#" class="btn-secondary-custom">
                        <i class="fas fa-map-marker-alt"></i> Visit Us
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
