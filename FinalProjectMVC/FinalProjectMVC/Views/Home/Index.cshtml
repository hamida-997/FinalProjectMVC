@model HomeVM
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">
                <h1>Freshly Baked<br>With Love</h1>
                <p class="subtitle">
                    Experience the finest artisan pastries, breads, and cakes made daily with premium ingredients and traditional recipes.
                </p>
                <div class="mt-4">
                    <a asp-controller="Products" asp-action="Index" class="btn-primary-custom">
                        Shop Now
                    </a>
                    <a asp-controller="Home" asp-action="About" class="btn-secondary-custom">
                        Our Story
                    </a>
                </div>
            </div>
            <div class="col-lg-6 hero-image">
                <div class="product-image" style="border-radius: 20px; height: 400px; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
                    <i class="fas fa-birthday-cake" style="font-size: 150px; color: var(--primary-color);"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Why Choose Us</h2>
            <p>We're committed to delivering the best bakery experience with quality, freshness, and taste</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-leaf" style="color: white; font-size: 2rem;"></i>
                    </div>
                    <h3>Fresh Ingredients</h3>
                    <p>We use only the finest, locally-sourced organic ingredients in all our products.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-clock" style="color: white; font-size: 2rem;"></i>
                    </div>
                    <h3>Baked Daily</h3>
                    <p>Everything is freshly baked every morning to ensure maximum taste and quality.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-award" style="color: white; font-size: 2rem;"></i>
                    </div>
                    <h3>Award Winning</h3>
                    <p>Recognized for excellence with multiple awards for our artisan techniques.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-heart" style="color: white; font-size: 2rem;"></i>
                    </div>
                    <h3>Made With Love</h3>
                    <p>Every item is crafted with passion and attention to detail by expert bakers.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Products Section -->
@* These used to be six hard-coded products that don't exist in the shop, with "Add to Cart"
   links to "#". They now come from the API, using the same card as the shop. *@
<section class="section" style="background-color: var(--bg-cream);">
    <div class="container">
        <div class="section-title">
            <h2>Featured Products</h2>
            <p>Our best-rated and newest bakery items</p>
        </div>

        @if (Model.FeaturedProducts.Any())
        {
            <div class="row g-4">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <div class="col-lg-4 col-md-6">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-center text-muted">Our menu is being updated. Please check back soon!</p>
        }

        <div class="text-center mt-5">
            <a asp-controller="Products" asp-action="Index" class="btn-primary-custom">View All Products</a>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="stats-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-6">
                <div class="stat-item">
                    <span class="stat-number">25+</span>
                    <span class="stat-label">Years Experience</span>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-item">
                    @* Was a fixed "150+"; now the real number of products in the shop *@
                    <span class="stat-number">@Model.ProductCount</span>
                    <span class="stat-label">Product@(Model.ProductCount == 1 ? "" : "s") Available</span>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-item">
                    <span class="stat-number">50K+</span>
                    <span class="stat-label">Happy Customers</span>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-item">
                    <span class="stat-number">15+</span>
                    <span class="stat-label">Master Bakers</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>What Our Customers Say</h2>
            <p>Recent reviews from customers who bought from us</p>
        </div>

        @* These were three made-up testimonials. They are now the latest real 4-5 star reviews
           (with a comment) from verified buyers. *@
        @if (Model.Testimonials.Any())
        {
            <div class="row g-4 justify-content-center">
                @foreach (var review in Model.Testimonials)
                {
                    var comment = review.Comment ?? "";
                    <div class="col-lg-4 col-md-6">
                        <div class="testimonial-card">
                            <div class="mb-3" aria-label="@review.Rating out of 5 stars">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= review.Rating ? "fas" : "far") fa-star" style="color: var(--accent-color);"></i>
                                }
                            </div>
                            <p class="testimonial-text">
                                "@(comment.Length > 220 ? comment[..220].TrimEnd() + "…" : comment)"
                            </p>
                            <p class="testimonial-author">@(string.IsNullOrWhiteSpace(review.ReviewerName) ? "Customer" : review.ReviewerName)</p>
                            <p class="testimonial-role">
                                <i class="fas fa-check-circle" style="color: #10B981;"></i> Verified buyer ·
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@review.ProductId" asp-fragment="reviews"
                                   style="color: inherit;">@review.ProductName</a>
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-center text-muted">
                No reviews yet. <a asp-controller="Products" asp-action="Index">Order something</a> and be the first to share what you think!
            </p>
        }
    </div>
</section>

<!-- Call to Action Section -->
<section class="section" style="background: linear-gradient(135deg, var(--bg-cream) 0%, #FFE8D6 100%); padding: 100px 0;">
    <div class="container text-center">
        <h2 style="color: var(--secondary-color); margin-bottom: 20px;">Visit Us Today</h2>
        <p style="font-size: 1.2rem; color: var(--text-light); margin-bottom: 30px; max-width: 600px; margin-left: auto; margin-right: auto;">
            Stop by our bakery for a warm, welcoming experience and the freshest baked goods in town.
        </p>
        @* Was a link to Home/Contact, which doesn't exist (404). Opens the footer address in Google Maps. *@
        <a href="https://www.google.com/maps/search/?api=1&amp;query=@Uri.EscapeDataString("123 Bakery Street, Sweet City")"
           target="_blank" rel="noopener" class="btn-primary-custom" style="font-size: 1.1rem; padding: 16px 40px;">
            <i class="fas fa-map-marker-alt"></i> Get Directions
        </a>
    </div>
</section>
