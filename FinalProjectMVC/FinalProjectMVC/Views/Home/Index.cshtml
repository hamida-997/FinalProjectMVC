@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">
                <h1>Freshly Baked<br>With Love</h1>
                <p class="subtitle">
                    Experience the finest artisan pastries, breads, and cakes made daily with premium ingredients and traditional recipes.
                </p>
                <div class="mt-4">
                    <a asp-controller="Products" asp-action="Index" class="btn-primary-custom">
                        Shop Now
                    </a>
                    <a asp-controller="Home" asp-action="About" class="btn-secondary-custom">
                        Our Story
                    </a>
                </div>
            </div>
            <div class="col-lg-6 hero-image">
                <div class="product-image" style="border-radius: 20px; height: 400px; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
                    <i class="fas fa-birthday-cake" style="font-size: 150px; color: var(--primary-color);"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Why Choose Us</h2>
            <p>We're committed to delivering the best bakery experience with quality, freshness, and taste</p>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-leaf" style="color: white; font-size: 2rem;"></i>
                    </div>
                    <h3>Fresh Ingredients</h3>
                    <p>We use only the finest, locally-sourced organic ingredients in all our products.</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-clock" style="color: white; font-size: 2rem;"></i>
                    </div>
                    <h3>Baked Daily</h3>
                    <p>Everything is freshly baked every morning to ensure maximum taste and quality.</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-award" style="color: white; font-size: 2rem;"></i>
                    </div>
                    <h3>Award Winning</h3>
                    <p>Recognized for excellence with multiple awards for our artisan techniques.</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-heart" style="color: white; font-size: 2rem;"></i>
                    </div>
                    <h3>Made With Love</h3>
                    <p>Every item is crafted with passion and attention to detail by expert bakers.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Products Section -->
<section class="section" style="background-color: var(--bg-cream);">
    <div class="container">
        <div class="section-title">
            <h2>Featured Products</h2>
            <p>Discover our most popular and beloved bakery items</p>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="product-card">
                    <div class="product-image">
                        <i class="fas fa-bread-slice" style="font-size: 100px; color: var(--primary-color);"></i>
                    </div>
                    <div class="product-info">
                        <h4>Artisan Sourdough</h4>
                        <p class="product-price">$8.99</p>
                        <p>Classic sourdough with a perfect crust and soft, tangy interior.</p>
                        <a href="#" class="btn-primary-custom btn-sm">Add to Cart</a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="product-card">
                    <div class="product-image">
                        <i class="fas fa-cookie" style="font-size: 100px; color: var(--primary-color);"></i>
                    </div>
                    <div class="product-info">
                        <h4>Chocolate Chip Cookies</h4>
                        <p class="product-price">$12.99</p>
                        <p>Dozen fresh-baked cookies loaded with premium chocolate chips.</p>
                        <a href="#" class="btn-primary-custom btn-sm">Add to Cart</a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="product-card">
                    <div class="product-image">
                        <i class="fas fa-birthday-cake" style="font-size: 100px; color: var(--primary-color);"></i>
                    </div>
                    <div class="product-info">
                        <h4>Custom Celebration Cake</h4>
                        <p class="product-price">$45.99</p>
                        <p>Beautiful custom cakes for any special occasion you celebrate.</p>
                        <a href="#" class="btn-primary-custom btn-sm">Order Now</a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="product-card">
                    <div class="product-image">
                        <i class="fas fa-croissant" style="font-size: 100px; color: var(--primary-color);"></i>
                    </div>
                    <div class="product-info">
                        <h4>Butter Croissant</h4>
                        <p class="product-price">$4.99</p>
                        <p>Flaky, buttery perfection in every layer of our French croissant.</p>
                        <a href="#" class="btn-primary-custom btn-sm">Add to Cart</a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="product-card">
                    <div class="product-image">
                        <i class="fas fa-pizza-slice" style="font-size: 100px; color: var(--primary-color);"></i>
                    </div>
                    <div class="product-info">
                        <h4>Fruit Danish</h4>
                        <p class="product-price">$5.99</p>
                        <p>Light, flaky pastry topped with fresh seasonal fruit and glaze.</p>
                        <a href="#" class="btn-primary-custom btn-sm">Add to Cart</a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="product-card">
                    <div class="product-image">
                        <i class="fas fa-cheese" style="font-size: 100px; color: var(--primary-color);"></i>
                    </div>
                    <div class="product-info">
                        <h4>Cheesecake Slice</h4>
                        <p class="product-price">$7.99</p>
                        <p>Rich, creamy New York style cheesecake with graham crust.</p>
                        <a href="#" class="btn-primary-custom btn-sm">Add to Cart</a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-5">
            <a asp-controller="Products" asp-action="Index" class="btn-primary-custom">View All Products</a>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="stats-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-6">
                <div class="stat-item">
                    <span class="stat-number">25+</span>
                    <span class="stat-label">Years Experience</span>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-item">
                    <span class="stat-number">150+</span>
                    <span class="stat-label">Products Available</span>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-item">
                    <span class="stat-number">50K+</span>
                    <span class="stat-label">Happy Customers</span>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-item">
                    <span class="stat-number">15+</span>
                    <span class="stat-label">Master Bakers</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>What Our Customers Say</h2>
            <p>Read what people are saying about our bakery</p>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="testimonial-card">
                    <div class="mb-3">
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                    </div>
                    <p class="testimonial-text">
                        "The best bakery in town! Their croissants are absolutely divine, and the customer service is exceptional. I'm a regular customer now!"
                    </p>
                    <p class="testimonial-author">Sarah Johnson</p>
                    <p class="testimonial-role">Food Blogger</p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="testimonial-card">
                    <div class="mb-3">
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                    </div>
                    <p class="testimonial-text">
                        "Ordered a custom birthday cake and it exceeded all expectations! Beautiful design, incredible taste. Will definitely order again!"
                    </p>
                    <p class="testimonial-author">Michael Chen</p>
                    <p class="testimonial-role">Event Planner</p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="testimonial-card">
                    <div class="mb-3">
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                        <i class="fas fa-star" style="color: var(--accent-color);"></i>
                    </div>
                    <p class="testimonial-text">
                        "Fresh, delicious, and made with quality ingredients. You can really taste the difference. My family loves their sourdough bread!"
                    </p>
                    <p class="testimonial-author">Emily Rodriguez</p>
                    <p class="testimonial-role">Home Chef</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Section -->
<section class="section" style="background: linear-gradient(135deg, var(--bg-cream) 0%, #FFE8D6 100%); padding: 100px 0;">
    <div class="container text-center">
        <h2 style="color: var(--secondary-color); margin-bottom: 20px;">Visit Us Today</h2>
        <p style="font-size: 1.2rem; color: var(--text-light); margin-bottom: 30px; max-width: 600px; margin-left: auto; margin-right: auto;">
            Stop by our bakery for a warm, welcoming experience and the freshest baked goods in town.
        </p>
        <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom" style="font-size: 1.1rem; padding: 16px 40px;">
            Get Directions
        </a>
    </div>
</section>
