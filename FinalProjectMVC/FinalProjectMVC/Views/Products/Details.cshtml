@model ProductDetailsVM
@{
    ViewData["Title"] = Model.Product.Name;
    var product = Model.Product;

    // Hidden products can still be opened by URL, so don't offer them for sale
    var canBuy = product.IsAvailable && product.StockQuantity > 0;

    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Action("Details", "Products", new { id = product.Id })}";
    var shareUrl = Uri.EscapeDataString(pageUrl);
    var shareText = Uri.EscapeDataString($"{product.Name} at Caramellize");
}

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav class="breadcrumb-nav">
            <a asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i> Home
            </a>
            <i class="fas fa-chevron-right separator"></i>
            <a asp-controller="Products" asp-action="Index">Products</a>
            <i class="fas fa-chevron-right separator"></i>
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@product.CategoryId">
                @product.CategoryName
            </a>
            <i class="fas fa-chevron-right separator"></i>
            <span class="current">@product.Name</span>
        </nav>
    </div>
</section>

<!-- Product Details Main Section -->
<section class="product-details-section">
    <div class="container">
        <div class="row g-5">
            <!-- Image Gallery -->
            <div class="col-lg-6">
                <div class="product-gallery">
                    <div class="main-image-wrapper">
                        @{
                            var mainImage = product.Images.FirstOrDefault(i => i.IsPrimary);
                            if (mainImage == null)
                            {
                                mainImage = product.Images.FirstOrDefault();
                            }
                        }
                        @if (mainImage != null)
                        {
                            <img id="mainProductImage" src="@mainImage.ImageUrl" alt="@product.Name" class="main-image" />
                        }
                        else
                        {
                            <div class="main-image-placeholder">
                                <i class="fas fa-cookie-bite"></i>
                            </div>
                        }

                        <div class="image-badges">
                            @if ((DateTime.UtcNow - product.CreatedAt).TotalDays <= 7)
                            {
                                <span class="product-badge badge-new">New</span>
                            }
                        </div>

                        @if (mainImage != null)
                        {
                            @* Was a button that did nothing; now opens the photo being shown at full size *@
                            <button type="button" class="zoom-btn" title="View full size" onclick="window.open(document.getElementById('mainProductImage').src, '_blank')">
                                <i class="fas fa-expand"></i>
                            </button>
                        }
                    </div>

                    @if (product.Images.Count > 1)
                    {
                        <div class="thumbnail-list">
                            @foreach (var image in product.Images)
                            {
                                <div class="thumbnail @(image == mainImage ? "active" : "")" onclick="switchImage('@image.ImageUrl', this)">
                                    <img src="@image.ImageUrl" alt="Product image" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-lg-6">
                <div class="product-info-detail">
                    <span class="product-category-tag">@product.CategoryName</span>
                    <h1 class="product-title">@product.Name</h1>

                    <!-- Rating -->
                    <div class="product-rating">
                        @if (product.ReviewCount > 0)
                        {
                            <partial name="_StarRating" model="product.AverageRating" />
                            <a href="#reviews" class="rating-text">
                                @product.AverageRating.ToString("0.0") (@product.ReviewCount review@(product.ReviewCount != 1 ? "s" : ""))
                            </a>
                        }
                        else
                        {
                            <partial name="_StarRating" model="0d" />
                            <a href="#reviews" class="rating-text">No reviews yet</a>
                        }
                    </div>

                    <!-- Short Description -->
                    @if (!string.IsNullOrEmpty(product.Description))
                    {
                        <p class="product-short-desc">
                            @(product.Description.Length > 150 ? product.Description.Substring(0, 150) + "..." : product.Description)
                        </p>
                    }

                    <!-- Price -->
                    @* Removed a made-up "old price" (+20%) and "-20%" badge that every product showed *@
                    <div class="price-section">
                        <span class="current-price">$@product.Price.ToString("F2")</span>
                    </div>

                    <!-- Stock Status -->
                    <div class="stock-status">
                        @if (!canBuy && product.StockQuantity > 0)
                        {
                            <div class="stock-indicator out-of-stock">
                                <i class="fas fa-pause-circle"></i>
                                <span>Currently unavailable</span>
                            </div>
                        }
                        else if (product.StockQuantity >= 10)
                        {
                            <div class="stock-indicator in-stock">
                                <i class="fas fa-check-circle"></i>
                                <span>In Stock (@product.StockQuantity available)</span>
                            </div>
                        }
                        else if (product.StockQuantity > 0)
                        {
                            <div class="stock-indicator low-stock">
                                <i class="fas fa-exclamation-circle"></i>
                                <span>Only @product.StockQuantity left in stock!</span>
                            </div>
                        }
                        else
                        {
                            <div class="stock-indicator out-of-stock">
                                <i class="fas fa-times-circle"></i>
                                <span>Out of Stock</span>
                            </div>
                        }
                    </div>

                    <!-- Quantity Selector -->
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="purchase-section">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@product.Id" />

                        <div class="quantity-section">
                            <label>Quantity:</label>
                            <div class="quantity-selector">
                                <button type="button" class="qty-btn" onclick="updateQuantity(-1)">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <input type="number" id="productQuantity" name="quantity" value="1" min="1" max="@Math.Max(1, product.StockQuantity)" readonly @(canBuy ? "" : "disabled") />
                                <button type="button" class="qty-btn" onclick="updateQuantity(1)">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons">
                            <button type="submit" class="btn-add-cart-big" @(canBuy ? "" : "disabled")>
                                <i class="fas fa-shopping-cart"></i>
                                @(canBuy ? "Add to Cart" : product.StockQuantity == 0 ? "Sold Out" : "Unavailable")
                            </button>
                            @* The heart (favorites) button did nothing, so it was removed *@
                            <button type="button" class="btn-share" title="Share or copy link" onclick="shareProduct()">
                                <i class="fas fa-share-alt"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Features -->
                    <div class="product-features">
                        <div class="feature-item">
                            <i class="fas fa-shipping-fast"></i>
                            <div>
                                <strong>Free Delivery</strong>
                                <span>On orders over $50</span>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-leaf"></i>
                            <div>
                                <strong>Fresh Daily</strong>
                                <span>Baked every morning</span>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-award"></i>
                            <div>
                                <strong>Premium Quality</strong>
                                <span>Organic ingredients</span>
                            </div>
                        </div>
                    </div>

                    <!-- Share Section -->
                    <div class="share-section">
                        <span class="share-label">Share:</span>
                        @* These were href="#" links that did nothing *@
                        <div class="share-icons">
                            <a href="https://www.facebook.com/sharer/sharer.php?u=@shareUrl" target="_blank" rel="noopener" class="share-icon facebook" aria-label="Share on Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a href="https://twitter.com/intent/tweet?url=@shareUrl&amp;text=@shareText" target="_blank" rel="noopener" class="share-icon twitter" aria-label="Share on X"><i class="fab fa-twitter"></i></a>
                            <a href="https://pinterest.com/pin/create/button/?url=@shareUrl&amp;description=@shareText" target="_blank" rel="noopener" class="share-icon pinterest" aria-label="Share on Pinterest"><i class="fab fa-pinterest"></i></a>
                            <a href="https://wa.me/?text=@shareText%20@shareUrl" target="_blank" rel="noopener" class="share-icon whatsapp" aria-label="Share on WhatsApp"><i class="fab fa-whatsapp"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



<!-- Reviews Section -->
<partial name="_ProductReviews" model="Model" />

<!-- Related Products Section -->
@if (Model.RelatedProducts.Any())
{
    <section class="related-products-section">
        <div class="container">
            <div class="section-title">
                <span class="section-subtitle">More From This Category</span>
                <h2>You May Also Like</h2>
                <p>Discover more delicious treats from our @product.CategoryName collection</p>
            </div>

            <div class="row g-4 mt-3">
                @foreach (var related in Model.RelatedProducts)
                {
                    <div class="col-xl-3 col-md-6">
                        <partial name="_ProductCard" model="related" />
                    </div>
                }
            </div>

            <div class="text-center mt-5">
                <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@product.CategoryId" class="btn-primary-custom">
                    <i class="fas fa-th-large"></i> View All @product.CategoryName
                </a>
            </div>
        </div>
    </section>
}

@section Scripts {
    <script>
        // Switch main image when thumbnail clicked
        function switchImage(url, element) {
            document.getElementById('mainProductImage').src = url;
            document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
            element.classList.add('active');
        }

        // Quantity selector
        function updateQuantity(delta) {
            const input = document.getElementById('productQuantity');
            if (input.disabled) return;
            const max = parseInt(input.max);
            const current = parseInt(input.value);
            const newValue = current + delta;
            if (newValue >= 1 && newValue <= max) {
                input.value = newValue;
            }
        }

        // Share button: the phone's share sheet if there is one, otherwise copy the link
        async function shareProduct() {
            const url = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pageUrl));
            const title = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(product.Name));
            try {
                if (navigator.share) {
                    await navigator.share({ title, url });
                } else {
                    await navigator.clipboard.writeText(url);
                    alert('Link copied to clipboard.');
                }
            } catch { /* user closed the share sheet */ }
        }
    </script>
}
