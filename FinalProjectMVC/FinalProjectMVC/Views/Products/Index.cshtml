@model ProductsListVM
@{
    ViewData["Title"] = "Our Products";
}

<!-- Page Header -->
<section class="products-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <span class="section-subtitle">Our Collection</span>
                <h1 class="products-header-title">Delicious Baked Goods</h1>
                <p class="products-header-text">
                    Discover our full selection of handcrafted pastries, breads, and cakes
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Products Section -->
<section class="section products-main-section">
    <div class="container">
        <div class="row">
            <!-- Sidebar Filters -->
            <aside class="col-lg-3 mb-4">
                <div class="filter-sidebar">
                    <!-- Search -->
                    <div class="filter-block">
                        <h4 class="filter-title">
                            <i class="fas fa-search"></i> Search
                        </h4>
                        <form method="get" asp-action="Index" class="search-form">
                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                            <input type="hidden" name="sortBy" value="@Model.SortBy" />
                            <div class="search-input-wrapper">
                                <input type="text" name="search" value="@Model.SearchTerm"
                                       placeholder="Search products..." class="filter-input" />
                                <button type="submit" class="search-btn">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Categories -->
                    <div class="filter-block">
                        <h4 class="filter-title">
                            <i class="fas fa-th-large"></i> Categories
                        </h4>
                        <ul class="category-filter-list">
                            <li>
                                <a asp-action="Index"
                                   asp-route-search="@Model.SearchTerm"
                                   asp-route-sortBy="@Model.SortBy"
                                   class="@(Model.SelectedCategoryId == null ? "active" : "")">
                                    <span>All Products</span>
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                            @foreach (var category in Model.Categories)
                            {
                                <li>
                                    <a asp-action="Index"
                                       asp-route-categoryId="@category.Id"
                                       asp-route-search="@Model.SearchTerm"
                                       asp-route-sortBy="@Model.SortBy"
                                       class="@(Model.SelectedCategoryId == category.Id ? "active" : "")">
                                        <span>@category.Name</span>
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Promo Banner -->
                    <div class="filter-promo">
                        <div class="promo-icon">
                            <i class="fas fa-gift"></i>
                        </div>
                        <h5>Special Offer</h5>
                        <p>Get 15% off on your first order</p>
                        <span class="promo-code">WELCOME15</span>
                    </div>
                </div>
            </aside>

            <!-- Products Grid -->
            <div class="col-lg-9">
                <!-- Toolbar -->
                <div class="products-toolbar">
                    <div class="results-count">
                        <strong>@Model.TotalProducts</strong> product@(Model.TotalProducts != 1 ? "s" : "") found
                        @if (Model.SelectedCategoryId.HasValue)
                        {
                            var selectedCategory = Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId);
                            if (selectedCategory != null)
                            {
                                <span class="active-filter">in <strong>@selectedCategory.Name</strong></span>
                            }
                        }
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <span class="active-filter">for "<strong>@Model.SearchTerm</strong>"</span>
                        }
                    </div>

                    <div class="sort-dropdown">
                        <form method="get" asp-action="Index" id="sortForm">
                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                            <input type="hidden" name="search" value="@Model.SearchTerm" />
                            <label for="sortBy"><i class="fas fa-sort"></i> Sort by:</label>
                            <select name="sortBy" id="sortBy" onchange="document.getElementById('sortForm').submit()">
                                <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Name (A-Z)</option>
                                <option value="name-desc" selected="@(Model.SortBy == "name-desc")">Name (Z-A)</option>
                                <option value="price-asc" selected="@(Model.SortBy == "price-asc")">Price: Low to High</option>
                                <option value="price-desc" selected="@(Model.SortBy == "price-desc")">Price: High to Low</option>
                                <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                            </select>
                        </form>
                    </div>
                </div>

                <!-- Products Grid -->
                @if (Model.Products.Any())
                {
                    <div class="row g-4 products-grid">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-xl-4 col-md-6">
                                <div class="product-card-modern">
                                    <div class="product-card-image">
                                        @if (!string.IsNullOrEmpty(product.PrimaryImageUrl))
                                        {
                                            <img src="@product.PrimaryImageUrl" alt="@product.Name" />
                                        }
                                        else
                                        {
                                            <div class="product-placeholder">
                                                <i class="fas fa-cookie-bite"></i>
                                            </div>
                                        }

                                        <div class="product-badges">
                                            @if ((DateTime.UtcNow - product.CreatedAt).TotalDays <= 7)
                                            {
                                                <span class="product-badge badge-new">New</span>
                                            }
                                            @if (product.StockQuantity < 10 && product.StockQuantity > 0)
                                            {
                                                <span class="product-badge badge-low-stock">Low Stock</span>
                                            }
                                        </div>

                                        <div class="product-card-overlay">
                                            <a asp-action="Details" asp-route-id="@product.Id" class="overlay-btn" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button type="button" class="overlay-btn" title="Add to Favorites">
                                                <i class="fas fa-heart"></i>
                                            </button>
                                            <button type="button" class="overlay-btn" title="Quick View">
                                                <i class="fas fa-shopping-bag"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="product-card-body">
                                        <span class="product-category-tag">@product.CategoryName</span>
                                        <h3 class="product-card-name">
                                            <a asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                        </h3>
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <p class="product-card-desc">
                                                @(product.Description.Length > 70 ? product.Description.Substring(0, 70) + "..." : product.Description)
                                            </p>
                                        }
                                        <div class="product-card-footer">
                                            <span class="product-card-price">$@product.Price.ToString("F2")</span>
                                            <button type="button" class="btn-add-cart">
                                                <i class="fas fa-plus"></i>
                                                <span>Add</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="fas fa-search"></i>
                        </div>
                        <h3>No products found</h3>
                        <p>Try adjusting your filters or search terms to find what you're looking for.</p>
                        <a asp-action="Index" class="btn-primary-custom">
                            <i class="fas fa-refresh"></i> Clear Filters
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
