@model FooterVM
@{
    // Contact details (the home page "Get Directions" button uses the same address)
    const string address = "123 Bakery Street, Sweet City";
    const string phoneDisplay = "(555) 123-4567";
    const string phoneLink = "+15551234567";
    const string email = "info@caramellize.com";
    var mapsUrl = "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(address);
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<footer class="footer-custom">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-4 footer-section">
                <h4><i class="fas fa-birthday-cake"></i> Caramellize</h4>
                <p>Artisan bakery crafting delicious pastries, cakes, and bread with love and the finest ingredients.</p>
                @* The social icons linked to "#" (no real accounts), so they were removed.
                   Add them back with real profile URLs when the bakery has them. *@
            </div>

            <div class="col-lg-2 col-md-6 mb-4 footer-section">
                <h4>Quick Links</h4>
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-area="" asp-controller="Products" asp-action="Index">Products</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="About">About Us</a></li>
                    <li><a asp-area="" asp-controller="Cart" asp-action="Index">Cart</a></li>
                    @if (isLoggedIn)
                    {
                        <li><a asp-area="" asp-controller="Account" asp-action="Orders">My Orders</a></li>
                    }
                    else
                    {
                        <li><a asp-area="" asp-controller="Auth" asp-action="Login">Login</a></li>
                    }
                </ul>
            </div>

            <div class="col-lg-3 col-md-6 mb-4 footer-section">
                <h4>Categories</h4>
                <ul>
                    @* The fallback list used to be five made-up categories linking to "#" *@
                    @foreach (var category in Model.Categories)
                    {
                        <li>
                            <a asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">
                                @category.Name
                            </a>
                        </li>
                    }
                    <li>
                        <a asp-area="" asp-controller="Products" asp-action="Index">
                            @(Model.HasMoreCategories ? "View all categories" : Model.Categories.Any() ? "All products" : "Browse all products")
                            <i class="fas fa-arrow-right ms-1" style="font-size: 0.75rem;"></i>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6 mb-4 footer-section">
                <h4>Contact Info</h4>
                @* Address, phone and email are now links (maps, call, email) *@
                <ul class="footer-contact">
                    <li>
                        <i class="fas fa-map-marker-alt"></i>
                        <a href="@mapsUrl" target="_blank" rel="noopener">@address</a>
                    </li>
                    <li>
                        <i class="fas fa-phone"></i>
                        <a href="tel:@phoneLink">@phoneDisplay</a>
                    </li>
                    <li>
                        <i class="fas fa-envelope"></i>
                        <a href="mailto:@email">@email</a>
                    </li>
                    <li>
                        <i class="fas fa-clock"></i>
                        <span>Mon-Sat: 7AM - 8PM</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p class="mb-0">&copy; @DateTime.Now.Year Caramellize Bakery. All rights reserved.</p>
        </div>
    </div>
</footer>
