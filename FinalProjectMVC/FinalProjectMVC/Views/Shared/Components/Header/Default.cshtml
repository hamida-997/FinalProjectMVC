@model HeaderVM
@{
    // Highlight the menu item for the current page
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    // Send people back to the page they were on after logging in (not to another auth page)
    var onAuthPage = string.Equals(controller, "Auth", StringComparison.OrdinalIgnoreCase);
    var returnUrl = onAuthPage ? null : $"{Context.Request.Path}{Context.Request.QueryString}";

    var cartCount = Model.CartItemCount > 99 ? "99+" : Model.CartItemCount.ToString();
}

<header>
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top" aria-label="Main navigation">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-birthday-cake"></i> Caramellize
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link @Active("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("Products")" asp-area="" asp-controller="Products" asp-action="Index"><i class="fas fa-cookie-bite"></i> Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("Home", "About")" asp-area="" asp-controller="Home" asp-action="About"><i class="fas fa-info-circle"></i> About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link position-relative @Active("Cart")" asp-area="" asp-controller="Cart" asp-action="Index"
                           aria-label="Cart, @Model.CartItemCount item@(Model.CartItemCount == 1 ? "" : "s")">
                            <i class="fas fa-shopping-cart"></i> Cart
                            @if (Model.CartItemCount > 0)
                            {
                                <span class="cart-badge" aria-hidden="true">@cartCount</span>
                            }
                        </a>
                    </li>

                    @if (Model.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-menu-toggle @Active("Account")" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                                <div class="user-avatar">@Model.Initial</div>
                                <span class="user-name-text">@Model.DisplayName</span>
                                <i class="fas fa-chevron-down user-menu-caret"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                                <li class="user-dropdown-header">
                                    <div class="fw-bold">@Model.FullName</div>
                                    <small class="text-muted">@Model.Email</small>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                @if (Model.IsAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>Admin Panel
                                        </a>
                                    </li>
                                }
                                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile"><i class="fas fa-user me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Orders"><i class="fas fa-shopping-bag me-2"></i>My Orders</a></li>
                                @* "Favorites" linked to "#"; there is no favorites feature, so it was removed *@
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    @* Logout is a POST with an anti-forgery token, so another site can't log people out *@
                                    <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @Active("Auth", "Login")" asp-area="" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@returnUrl">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn-primary-custom btn-sm header-signup" asp-area="" asp-controller="Auth" asp-action="Register">
                                Sign Up
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
