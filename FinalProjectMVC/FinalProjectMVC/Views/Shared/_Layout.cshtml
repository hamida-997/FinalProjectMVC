<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Caramellize Bakery</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinalProjectMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-birthday-cake"></i> Caramellize
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="fas fa-shopping-cart"></i> Cart
                            </a>
                        </li>
                        @if (Context.Session.GetString("AuthToken") != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle"></i> @Context.Session.GetString("UserName")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>Profile</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-shopping-bag me-2"></i>My Orders</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Auth" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Login
                                </a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn-primary-custom btn-sm" asp-controller="Auth" asp-action="Register" style="padding: 8px 20px; font-size: 0.9rem;">
                                    Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" style="margin-top: 76px;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-toast" id="successToast">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <script>
                setTimeout(() => {
                    const toast = document.getElementById('successToast');
                    if (toast) toast.remove();
                }, 3500);
            </script>
        }
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4 footer-section">
                    <h4><i class="fas fa-birthday-cake"></i> Caramellize</h4>
                    <p>Artisan bakery crafting delicious pastries, cakes, and bread with love and the finest ingredients.</p>
                    <div class="social-links mt-3">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-pinterest"></i></a>
                    </div>
                </div>
                
                <div class="col-lg-2 col-md-6 mb-4 footer-section">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Products" asp-action="Index">Products</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-4 footer-section">
                    <h4>Categories</h4>
                    <ul>
                        <li><a href="#">Cakes & Cupcakes</a></li>
                        <li><a href="#">Breads</a></li>
                        <li><a href="#">Pastries</a></li>
                        <li><a href="#">Cookies</a></li>
                        <li><a href="#">Special Orders</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-4 footer-section">
                    <h4>Contact Info</h4>
                    <ul style="list-style: none; padding: 0;">
                        <li style="margin-bottom: 15px;">
                            <i class="fas fa-map-marker-alt" style="width: 20px;"></i> 123 Bakery Street, Sweet City
                        </li>
                        <li style="margin-bottom: 15px;">
                            <i class="fas fa-phone" style="width: 20px;"></i> (555) 123-4567
                        </li>
                        <li style="margin-bottom: 15px;">
                            <i class="fas fa-envelope" style="width: 20px;"></i> info@caramellize.com
                        </li>
                        <li>
                            <i class="fas fa-clock" style="width: 20px;"></i> Mon-Sat: 7AM - 8PM
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year Caramellize Bakery. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
